{# templates/mails/booking_rejected.html.twig #}
<!DOCTYPE html>
<html lang="ja">

	<head>
		<meta charset="UTF-8">
		<title>予約に関するお知らせ</title>

		<style>
			body {
				margin: 0;
				padding: 40px 20px;
				background: #f5f7fa;
				font-family: Arial, Helvetica, sans-serif;
				color: #4b5563;
			}

			table {
				border-collapse: collapse;
				border-spacing: 0;
			}

			.wrapper {
				width: 100%;
			}

			.card {
				width: 100%;
				max-width: 620px;
				margin: auto;
				background: #ffffff;
				border-radius: 20px;
				overflow: hidden;
				box-shadow: 0 15px 40px rgba(3, 56, 98, 0.08);
			}

			.header {
				background: #033862;
				padding: 45px 40px;
				text-align: center;
			}

			.logo-box {
				display: inline-block;
				background: #ffffff;
				border-radius: 14px;
				padding: 18px 28px;
				margin-bottom: 30px;
			}

			.logo-box img {
				height: 50px;
				vertical-align: middle;
			}

			.logo-box img:first-child {
				margin-right: 18px;
			}

			h1 {
				margin: 0;
				color: #ffffff;
				font-size: 30px;
				font-weight: bold;
			}

			.content {
				padding: 50px;
			}

			.content p {
				margin: 0 0 22px;
				line-height: 1.8;
				font-size: 16px;
			}

			.greeting {
				font-size: 18px;
				font-weight: bold;
				color: #111827;
				margin: 0 0 24px;
			}

			.reject-box {
				background: #fef2f2;
				border-left: 4px solid #b91c1c;
				border-radius: 8px;
				padding: 18px 22px;
				margin: 0 0 24px;
			}

			.reject-box p {
				margin: 0;
				color: #7f1d1d;
				font-weight: bold;
			}

			.divider {
				margin: 40px 0;
				border-top: 1px solid #ececec;
			}

			.info {
				background: #fff8e5;
				border: 1px solid #f3d37c;
				border-radius: 12px;
				padding: 18px 20px;
				font-size: 14px;
				line-height: 1.6;
			}

			.footer {
				background: #fafafa;
				border-top: 1px solid #ececec;
				padding: 30px;
				text-align: center;
				font-size: 13px;
				color: #6b7280;
				line-height: 1.7;
			}

			@media only screen and(max-width:600px) {

				body {
					padding: 20px 10px;
				}

				.content {
					padding: 32px 24px;
				}

				.logo-box {
					padding: 15px 20px;
				}

				.logo-box img {
					height: 40px;
				}

				h1 {
					font-size: 24px;
				}

			}
		</style>

	</head>

	<body>

		<table class="wrapper" role="presentation">

			<tr>

				<td align="center">

					<table class="card" role="presentation">

						<tr>

							<td class="header">

								<div class="logo-box">

									<img src="{{ absolute_url(asset('build/images/scf.svg')) }}" alt="SCFロゴ">

									<img src="{{ absolute_url(asset('build/images/kitokuras.svg')) }}" alt="Kitokurasロゴ">

								</div>

								<h1>
									予約に関するお知らせ
								</h1>

							</td>

						</tr>

						<tr>

							<td class="content">

								<p class="greeting">
									{{ user.fullName }} 様
								</p>

								<p>
									このたびのご予約についてお知らせいたします。
								</p>

								<div class="reject-box">
									<p>
										申し訳ございませんが、今回のご予約を承認することができませんでした。
									</p>
								</div>

								<p style="margin:0 0 16px; color:#4b5563; font-size:14px;">
									このメールにお支払い用のリンクは含まれておりません。
								</p>

								<p style="margin:0; color:#4b5563; font-size:14px;">
									今回の処理に心当たりがない場合、または誤りと思われる場合は、サイト管理者までお問い合わせください。
								</p>

							</td>

						</tr>

						<tr>

							<td class="footer">

								<strong>Setoushi Circus Factory - 予約システム</strong>

								<br><br>

								©
								{{ "now"|date("Y") }}

								<br><br>

								このメールはご予約に関する重要なお知らせです。<br>
								ご不明な点がございましたら、サイト管理者までご連絡ください。

							</td>

						</tr>

					</table>

				</td>

			</tr>

		</table>

	</body>

</html>
