<!DOCTYPE html>
<html lang="ja">

	<head>
		<meta charset="UTF-8">
		<title>お支払い完了</title>

		<style>
			body {
				margin: 0;
				padding: 40px 20px;
				background: #f5f7fa;
				font-family: Arial, Helvetica, sans-serif;
				color: #4b5563;
			}

			table {
				border-collapse: collapse;
				border-spacing: 0;
			}

			.wrapper {
				width: 100%;
			}

			.card {
				width: 100%;
				max-width: 620px;
				margin: auto;
				background: #ffffff;
				border-radius: 20px;
				overflow: hidden;
				box-shadow: 0 15px 40px rgba(3, 56, 98, 0.08);
			}

			.header {
				background: #033862;
				padding: 45px 40px;
				text-align: center;
			}

			.logo-box {
				display: inline-block;
				background: #ffffff;
				border-radius: 14px;
				padding: 18px 28px;
				margin-bottom: 30px;
			}

			.logo-box img {
				height: 50px;
				vertical-align: middle;
			}

			.logo-box img:first-child {
				margin-right: 18px;
			}

			h1 {
				margin: 0;
				color: #ffffff;
				font-size: 30px;
				font-weight: bold;
			}

			.content {
				padding: 50px;
				text-align: center;
			}

			.content p {
				margin: 0 0 22px;
				line-height: 1.8;
				font-size: 16px;
			}

			.status-icon {
				display: inline-block;
				width: 56px;
				height: 56px;
				line-height: 56px;
				border-radius: 9999px;
				background: #dcfce7;
				color: #16a34a;
				font-size: 28px;
				margin-bottom: 20px;
			}

			.details-box {
				margin: 24px 0;
				background: #fff8e5;
				border: 1px solid #f3d37c;
				border-radius: 12px;
				padding: 20px 24px;
				text-align: left;
				font-size: 14px;
				line-height: 1.8;
				color: #4b5563;
			}

			.details-box p {
				margin: 0;
			}

			.divider {
				margin: 40px 0;
				border-top: 1px solid #ececec;
			}

			.info {
				background: #fff8e5;
				border: 1px solid #f3d37c;
				border-radius: 12px;
				padding: 18px 20px;
				font-size: 14px;
				line-height: 1.6;
			}

			.footer {
				background: #fafafa;
				border-top: 1px solid #ececec;
				padding: 30px;
				text-align: center;
				font-size: 13px;
				color: #6b7280;
				line-height: 1.7;
			}

			@media only screen and(max-width:600px) {

				body {
					padding: 20px 10px;
				}

				.content {
					padding: 32px 24px;
				}

				.logo-box {
					padding: 15px 20px;
				}

				.logo-box img {
					height: 40px;
				}

				h1 {
					font-size: 24px;
				}

			}
		</style>

	</head>

	<body>

		<table class="wrapper" role="presentation">

			<tr>

				<td align="center">

					<table class="card" role="presentation">

						<tr>

							<td class="header">

								<div class="logo-box">

									<img src="{{ absolute_url(asset('build/images/scf.svg')) }}" alt="SCFロゴ">

									<img src="{{ absolute_url(asset('build/images/kitokuras.svg')) }}" alt="Kitokurasロゴ">

								</div>

								<h1>
									お支払い完了
								</h1>

							</td>

						</tr>

						<tr>

							<td class="content">

								<div class="status-icon">&#10003;</div>

								<p>
									お支払いを確認しました。
								</p>

								<div class="details-box">
									<p><strong>ユーザー：</strong> {{ user.fullName }}</p>
									<p style="margin-top:8px;"><strong>金額：</strong> {{ transaction.paidPrice }} {{ currency|default('JPY') }}</p>
								</div>

								<p style="margin:0; font-size:14px; color:#6b7280;">
									予約が確定しました。
								</p>

							</td>

						</tr>

						<tr>

							<td class="footer">

								<strong>Setoushi Circus Factory - 予約システム</strong>

								<br><br>

								©
								{{ "now"|date("Y") }}

								<br><br>

								このメールは自動送信されています。返信はご遠慮ください。

							</td>

						</tr>

					</table>

				</td>

			</tr>

		</table>

	</body>

</html>
