{% set facility = booking.zone.facility ?? null %}

{% set nowTs = 'now'|date('U', timezone|default('Asia/Tokyo')) %}
{% set startTs = booking.startDate|date('U', timezone|default('Asia/Tokyo')) %}
{% set diffSeconds = startTs - nowTs %}
{% set diffDays = (diffSeconds / 86400)|round(0, 'floor') %}

{% set accentColor = '#2563eb' %}
{% if diffDays <= 1 %}
    {% set accentColor = '#dc2626' %}
{% elseif diffDays <= 7 %}
    {% set accentColor = '#d97706' %}
{% elseif diffDays <= 31 %}
    {% set accentColor = '#2563eb' %}
{% else %}
    {% set accentColor = '#059669' %}
{% endif %}

<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{{ reminderLabel }}後のご予約のお知らせ</title>
<!--[if mso]>
<style type="text/css">
    table, td { font-family: Arial, Helvetica, sans-serif; }
</style>
<![endif]-->
<style>
    body, table, td { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    body { margin: 0; padding: 0; width: 100% !important; }
    img { border: 0; outline: none; text-decoration: none; }
    a { text-decoration: none; }

    @media only screen and (max-width: 480px) {
        .container { width: 100% !important; }
        .px { padding-left: 20px !important; padding-right: 20px !important; }
        .py-header { padding: 24px 20px !important; }
        .icon-circle { width: 44px !important; height: 44px !important; }
        .title { font-size: 19px !important; }
        .badge { font-size: 12px !important; }
        .row-label { display: block !important; width: 100% !important; padding-bottom: 2px !important; }
        .row-value { display: block !important; width: 100% !important; padding-left: 0 !important; text-align: left !important; }
    }
</style>
</head>
<body style="margin:0; padding:0; background-color:#f1f2f4; font-family:Arial, Helvetica, sans-serif; color:#1f2328;">

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:#f1f2f4; margin:0; padding:0;">
    <tr>
        <td align="center" style="padding:24px 16px;">
            <table role="presentation" class="container" width="480" cellspacing="0" cellpadding="0" style="width:480px; max-width:100%; background:#ffffff; border-radius:14px; overflow:hidden; border:1px solid #e5e7eb;">

                <tr>
                    <td class="py-header" align="center" style="padding:32px 24px 28px 24px; background:{{ accentColor }};">
                        <table role="presentation" cellspacing="0" cellpadding="0">
                            <tr>
                                <td class="icon-circle" align="center" valign="middle" width="52" height="52" style="width:52px; height:52px; border-radius:50%; background:rgba(255,255,255,0.18);">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:block;">
                                        <rect x="3" y="4.5" width="18" height="16" rx="2.5" stroke="#ffffff" stroke-width="1.8"/>
                                        <path d="M3 9.5H21" stroke="#ffffff" stroke-width="1.8"/>
                                        <path d="M7.5 2.5V6.5" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round"/>
                                        <path d="M16.5 2.5V6.5" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round"/>
                                        <rect x="7" y="12.5" width="3" height="3" rx="0.5" fill="#ffffff"/>
                                    </svg>
                                </td>
                            </tr>
                        </table>

                        <p class="badge" style="margin:16px 0 6px 0; font-size:13px; font-weight:bold; letter-spacing:0.4px; text-transform:uppercase; color:#ffffff; opacity:0.9;">
                            予約リマインダー
                        </p>

                        <h1 class="title" style="margin:0; font-size:21px; line-height:1.35; color:#ffffff; font-weight:bold;">
                            ご予約は{{ reminderLabel }}です
                        </h1>
                    </td>
                </tr>

                <tr>
                    <td class="px" style="padding:28px 28px 8px 28px;">
                        <p style="margin:0 0 8px 0; font-size:15px; line-height:1.6; color:#1f2328;">
                            {{ user.fullName }} 様
                        </p>
                        <p style="margin:0; font-size:15px; line-height:1.6; color:#4b5563;">
                            ご予約の日時が近づいておりますので、ご案内申し上げます。ご予約は{{ reminderLabel }}です。
                        </p>
                    </td>
                </tr>

                <tr>
                    <td class="px" style="padding:20px 28px 8px 28px;">
                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f8f9fb; border-radius:10px;">

                            <tr>
                                <td style="padding:16px 18px; border-bottom:1px solid #edeef1;">
                                    <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
                                        <tr>
                                            <td class="row-label" style="font-size:13px; color:#6b7280; width:40%; vertical-align:top;">
                                                ご予約まで
                                            </td>
                                            <td class="row-value" style="font-size:15px; color:#1f2328; font-weight:bold; text-align:right;">
                                                {{ reminderLabel }}
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>

                            <tr>
                                <td style="padding:16px 18px; {% if facility and (facility.name or facility.address) %}border-bottom:1px solid #edeef1;{% endif %}">
                                    <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
                                        <tr>
                                            <td class="row-label" style="font-size:13px; color:#6b7280; width:40%; vertical-align:top;">
                                                開始日時
                                            </td>
                                            <td class="row-value" style="font-size:15px; color:#1f2328; font-weight:bold; text-align:right;">
                                                {{ booking.startDate|date('Y/m/d H:i', timezone|default('Asia/Tokyo')) }}
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>

                            {% if facility and facility.name %}
                                <tr>
                                    <td style="padding:16px 18px; {% if facility.address %}border-bottom:1px solid #edeef1;{% endif %}">
                                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
                                            <tr>
                                                <td class="row-label" style="font-size:13px; color:#6b7280; width:40%; vertical-align:top;">
                                                    場所
                                                </td>
                                                <td class="row-value" style="font-size:15px; color:#1f2328; font-weight:bold; text-align:right;">
                                                    {{ facility.name }}
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            {% endif %}

                            {% if facility and facility.address %}
                                <tr>
                                    <td style="padding:16px 18px;">
                                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
                                            <tr>
                                                <td class="row-label" style="font-size:13px; color:#6b7280; width:40%; vertical-align:top;">
                                                    住所
                                                </td>
                                                <td class="row-value" style="font-size:15px; color:#1f2328; font-weight:bold; text-align:right;">
                                                    {{ facility.address }}
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            {% endif %}

                        </table>
                    </td>
                </tr>

                <tr>
                    <td class="px" style="padding:20px 28px 32px 28px;">
                        <p style="margin:0; font-size:14px; line-height:1.6; color:#4b5563;">
                            ご不明な点がございましたら、お気軽にお問い合わせください。
                        </p>
                    </td>
                </tr>

                <tr>
                    <td class="px" style="padding:18px 28px; background:#fafafa; border-top:1px solid #edeef1; color:#9ca3af; font-size:12px; line-height:1.5; text-align:center;">
                        このメールは自動送信されています。
                    </td>
                </tr>

            </table>
        </td>
    </tr>
</table>

</body>
</html>