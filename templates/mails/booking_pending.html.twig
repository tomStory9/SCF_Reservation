{# templates/mails/booking_pending.html.twig #}
<!DOCTYPE html>
<html lang="ja">

	<head>
		<meta charset="UTF-8">
		<title>ご予約リクエストを受け付けました</title>

		<style>
			body {
				margin: 0;
				padding: 40px 20px;
				background: #f5f7fa;
				font-family: Arial, Helvetica, sans-serif;
				color: #4b5563;
			}

			table {
				border-collapse: collapse;
				border-spacing: 0;
			}

			.wrapper {
				width: 100%;
			}

			.card {
				width: 100%;
				max-width: 620px;
				margin: auto;
				background: #ffffff;
				border-radius: 20px;
				overflow: hidden;
				box-shadow: 0 15px 40px rgba(3, 56, 98, 0.08);
			}

			.header {
				background: #033862;
				padding: 45px 40px;
				text-align: center;
			}

			.logo-box {
				display: inline-block;
				background: #ffffff;
				border-radius: 14px;
				padding: 18px 28px;
				margin-bottom: 30px;
			}

			.logo-box img {
				height: 50px;
				vertical-align: middle;
			}

			.logo-box img:first-child {
				margin-right: 18px;
			}

			h1 {
				margin: 0;
				color: #ffffff;
				font-size: 30px;
				font-weight: bold;
			}

			.content {
				padding: 50px;
			}

			.content p {
				margin: 0 0 22px;
				line-height: 1.8;
				font-size: 16px;
			}

			.greeting {
				font-size: 18px;
				font-weight: bold;
				color: #111827;
				margin: 0 0 24px;
			}

			.section-title {
				margin: 0 0 12px;
				font-size: 14px;
				font-weight: bold;
				color: #033862;
				text-transform: uppercase;
				letter-spacing: 0.5px;
			}

			.details-box {
				margin: 0 0 24px;
				border: 1px solid #e5e7eb;
				border-radius: 12px;
				overflow: hidden;
			}

			.details-box table {
				width: 100%;
			}

			.details-box td {
				padding: 12px 18px;
				font-size: 14px;
				line-height: 1.6;
				border-bottom: 1px solid #f0f0f0;
			}

			.details-box tr:last-child td {
				border-bottom: none;
			}

			.details-box td.label {
				width: 40%;
				color: #6b7280;
				background: #fafafa;
			}

			.details-box td.value {
				color: #111827;
				font-weight: bold;
			}

			.divider {
				margin: 40px 0;
				border-top: 1px solid #ececec;
			}

			.info {
				background: #fff8e5;
				border: 1px solid #f3d37c;
				border-radius: 12px;
				padding: 18px 20px;
				font-size: 14px;
				line-height: 1.6;
			}

			.footer {
				background: #fafafa;
				border-top: 1px solid #ececec;
				padding: 30px;
				text-align: center;
				font-size: 13px;
				color: #6b7280;
				line-height: 1.7;
			}

			@media only screen and(max-width:600px) {

				body {
					padding: 20px 10px;
				}

				.content {
					padding: 32px 24px;
				}

				.logo-box {
					padding: 15px 20px;
				}

				.logo-box img {
					height: 40px;
				}

				h1 {
					font-size: 24px;
				}

				.details-box td.label {
					width: 45%;
				}

			}
		</style>

	</head>

	<body>

		<table class="wrapper" role="presentation">

			<tr>

				<td align="center">

					<table class="card" role="presentation">

						<tr>

							<td class="header">

								<div class="logo-box">

									<img src="{{ absolute_url(asset('build/images/scf.svg')) }}" alt="SCFロゴ">

									<img src="{{ absolute_url(asset('build/images/kitokuras.svg')) }}" alt="Kitokurasロゴ">

								</div>

								<h1>
									ご予約リクエストを受け付けました
								</h1>

							</td>

						</tr>

						<tr>

							<td class="content">

								<p class="greeting">
									{{ user.fullName }} 様
								</p>

								<p>
									このたびはご予約のお申し込みをいただき、誠にありがとうございます。
								</p>

								<p>
									現在、ご予約内容を確認しております。承認または却下の結果は、追ってメールにてお知らせいたしますので、今しばらくお待ちください。
								</p>

								<p class="section-title">
									ご予約内容
								</p>

								<div class="details-box">

									<table role="presentation">

										<tr>
											<td class="label">ゾーン</td>
											<td class="value">{{ booking.zone.name }}</td>
										</tr>

										<tr>
											<td class="label">開始日時</td>
											<td class="value">{{ booking.startDate|date('Y年m月d日 H:i') }}</td>
										</tr>

										<tr>
											<td class="label">終了日時</td>
											<td class="value">{{ booking.endDate|date('Y年m月d日 H:i') }}</td>
										</tr>

										<tr>
											<td class="label">利用人数</td>
											<td class="value">{{ booking.guestCount }} 名</td>
										</tr>

									</table>

								</div>

								{% if booking.bookingEquipment|length > 0 %}

									<p class="section-title">
										利用備品
									</p>

									<div class="details-box">

										<table role="presentation">

											{% for be in booking.bookingEquipment %}
												<tr>
													<td class="value">{{ be.equipment.name }} × {{ be.quantity }}</td>
												</tr>
											{% endfor %}

										</table>

									</div>

								{% endif %}

								<div class="info">
									<strong>
										この段階ではまだお支払い手続きは発生しません
									</strong>
									<br>
									ご予約が承認された場合、改めてお支払いのご案内をお送りいたします。
								</div>

								<p style="margin-top:32px">
									ご不明な点がございましたら、このメールに返信してお問い合わせください。
								</p>

							</td>

						</tr>

						<tr>

							<td class="footer">

								<strong>Setoushi Circus Factory - 予約システム</strong>

								<br><br>

								©
								{{ "now"|date("Y") }}

								<br><br>

								このメールはご予約のお手続きに関する重要なお知らせです。<br>
								心当たりがない場合は、このメールを無視してください。

							</td>

						</tr>

					</table>

				</td>

			</tr>

		</table>

	</body>

</html>
