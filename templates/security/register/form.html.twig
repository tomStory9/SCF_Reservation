{% extends 'base.html.twig' %}

{% trans_default_domain 'register' %}

{% block title %}{{ 'profile.complete.title'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('user-profile') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('user-profile') }}
{% endblock %}

{% macro form_field(field, extra_classes = '') %}
    <div class="{{ extra_classes }}">
        {{ form_label(field, null, {'label_attr': {'class': 'mb-2 block text-sm font-medium text-state uppercase tracking-wider'}}) }}
        {{ form_widget(field, {
            'attr': {
                'class': 'w-full rounded-xl border bg-slate-50 px-4 py-3 text-secondary outline-none transition placeholder:text-state '
                ~ (field.vars.errors|length
                ? 'border-danger focus:border-danger focus:ring-2 focus:ring-danger bg-white'
                : 'border-slate-300 focus:border-primary focus:ring-2 focus:ring-primary bg-slate-50 focus:bg-white')
            }
        }) }}
        <div class="mt-1 text-sm font-medium text-danger">
            {{ form_errors(field) }}
        </div>
    </div>
{% endmacro %}

{% block body %}
    <div class="min-h-screen bg-slate-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">

        <div class="sm:mx-auto sm:w-full sm:max-w-3xl">

            <div class="mb-8 flex items-center justify-center gap-6">
                <img src="{{ asset('build/images/scf.svg') }}" alt="{{ 'app.logo_1'|trans }}" class="h-16 w-auto drop-shadow-sm">
                <img src="{{ asset('build/images/kitokuras.svg') }}" alt="{{ 'app.logo_2'|trans }}" class="h-16 w-auto drop-shadow-sm">
            </div>

            <div class="bg-white py-10 px-6 shadow-sm border border-slate-200 sm:rounded-3xl sm:px-12">

                <div class="mb-10 text-center">
                    <h1 class="text-3xl font-bold text-primary">{{ 'profile.complete.title'|trans }}</h1>
                    <p class="mt-3 text-state">{{ 'profile.complete.subtitle'|trans }}</p>
                </div>

                {% if form.vars.errors|length %}
                    <div class="mb-8 rounded-xl border border-danger bg-danger/10 p-4 text-sm text-danger">
                        {{ form_errors(form) }}
                    </div>
                {% endif %}

                {{ form_start(form, {'attr': {'class': 'space-y-8'}}) }}

                {# Informations de base #}
                <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
                    {{ _self.form_field(form.name) }}
                    {{ _self.form_field(form.lastname) }}

                    <div class="sm:col-span-2">
                        {{ _self.form_field(form.email) }}
                    </div>
                </div>

                <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
                    <div>
                        {{ form_label(form.phone, null, {'label_attr': {'class': 'mb-2 block text-sm font-medium text-state uppercase tracking-wider'}}) }}
                        <div data-controller="phone">
                            {{ form_widget(form.phone, {
                                'attr': {
                                    'class': 'w-full rounded-xl border bg-slate-50 px-4 py-3 text-secondary outline-none transition placeholder:text-state '
                                    ~ (form.phone.vars.errors|length
                                    ? 'border-danger focus:border-danger focus:ring-2 focus:ring-danger bg-white'
                                    : 'border-slate-300 focus:border-primary focus:ring-2 focus:ring-primary focus:bg-white')
                                }
                            }) }}
                        </div>
                        <div class="mt-1 text-sm font-medium text-danger">{{ form_errors(form.phone) }}</div>
                    </div>

                    {{ _self.form_field(form.birthDate) }}
                    {{ _self.form_field(form.nationalitie) }}
                    {{ _self.form_field(form.residenceCity) }}
                </div>

                {# Profil Cirque #}
                <div class="pt-6">
                    <div class="mb-6 border-b border-slate-100 pb-3">
                        <h3 class="text-xl font-bold text-secondary">{{ 'account.profile.circus_profile'|trans({}, 'profile') }}</h3>
                    </div>

                    <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
                        {{ _self.form_field(form.practiceStartYear) }}
                        {{ _self.form_field(form.lastPerformance) }}
                        {{ _self.form_field(form.company) }}
                        {{ _self.form_field(form.instagramAccount) }}

                        <div class="sm:col-span-2">
                            {{ form_label(form.specialties, null, {'label_attr': {'class': 'mb-2 block text-sm font-medium text-state uppercase tracking-wider'}}) }}

                            {{ form_widget(form.specialties, {
                                'attr': {
                                    'class': 'tom-select-specialties w-full',
                                    'data-placeholder': 'account.profile.specialties_placeholder'|trans({}, 'profile')
                                }
                            }) }}
                            <div class="mt-1 text-sm font-medium text-danger">{{ form_errors(form.specialties) }}</div>
                        </div>
                    </div>
                </div>

                <div class="pt-4">
                    <button type="submit" class="w-full rounded-xl bg-secondary py-4 text-lg font-semibold text-white transition hover:bg-secondary/90 hover:shadow-lg">
                        {{ 'profile.complete.submit'|trans }}
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
