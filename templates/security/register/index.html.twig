{% extends 'base.html.twig' %}

{% trans_default_domain 'register' %}

{% block title %}{{ 'register.title'|trans }}{% endblock %}
{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('carousel') }}
{% endblock %}
{% block body %}
<div class="flex min-h-screen bg-white">

    <main class="flex w-full items-center justify-center p-4 lg:w-1/2 lg:p-8">
        <div class="w-full max-w-lg">

            <div class="mb-6 flex items-center justify-center gap-4">
                <img
                    src="{{ asset('build/images/scf.svg') }}"
                    alt="{{ 'app.logo_1'|trans }}"
                    class="h-14 w-auto"
                >

                <img
                    src="{{ asset('build/images/kitokuras.svg') }}"
                    alt="{{ 'app.logo_2'|trans }}"
                    class="h-14 w-auto"
                >
            </div>

            <div class="mb-6 text-center">
                <h1 class="text-3xl font-bold text-primary">
                    {{ 'register.title'|trans }}
                </h1>

                <p class="mt-2 text-secondary">
                    {{ 'register.subtitle'|trans }}
                </p>
            </div>

            {% if registrationForm.vars.errors|length %}
                <div class="mb-6 rounded-xl border border-danger bg-danger/10 p-4 text-sm text-danger">
                    {{ form_errors(registrationForm) }}
                </div>
            {% endif %}

            {{ form_start(registrationForm, {
                attr: {
                    class: 'space-y-4'
                }
            }) }}

                <div class="grid gap-4 sm:grid-cols-2">

                    <div>
                        {{ form_label(registrationForm.name, null, {
                            label_attr: {
                                class: 'mb-2 block text-sm font-medium text-state'
                            }
                        }) }}

                        {{ form_widget(registrationForm.name, {
                            attr: {
                                class: 'w-full rounded-xl border bg-white px-4 py-3 text-state outline-none transition placeholder:text-state '
                                    ~ (registrationForm.name.vars.errors|length
                                        ? 'border-danger focus:border-danger focus:ring-2 focus:ring-danger'
                                        : 'border-state focus:border-primary focus:ring-2 focus:ring-primary')
                            }
                        }) }}

                        <div class="mt-2 text-sm font-medium text-danger">
                            {{ form_errors(registrationForm.name) }}
                        </div>
                    </div>

                    <div>
                        {{ form_label(registrationForm.lastname, null, {
                            label_attr: {
                                class: 'mb-2 block text-sm font-medium text-state'
                            }
                        }) }}

                        {{ form_widget(registrationForm.lastname, {
                            attr: {
                                class: 'w-full rounded-xl border bg-white px-4 py-3 text-state outline-none transition placeholder:text-state '
                                    ~ (registrationForm.lastname.vars.errors|length
                                        ? 'border-danger focus:border-danger focus:ring-2 focus:ring-danger'
                                        : 'border-state focus:border-primary focus:ring-2 focus:ring-primary')
                            }
                        }) }}

                        <div class="mt-2 text-sm font-medium text-danger">
                            {{ form_errors(registrationForm.lastname) }}
                        </div>
                    </div>

                </div>

                <div>
                    {{ form_label(registrationForm.email, null, {
                        label_attr: {
                            class: 'mb-2 block text-sm font-medium text-state'
                        }
                    }) }}

                    {{ form_widget(registrationForm.email, {
                        attr: {
                            class: 'w-full rounded-xl border bg-white px-4 py-3 text-state outline-none transition placeholder:text-state '
                                ~ (registrationForm.email.vars.errors|length
                                    ? 'border-danger focus:border-danger focus:ring-2 focus:ring-danger'
                                    : 'border-state focus:border-primary focus:ring-2 focus:ring-primary')
                        }
                    }) }}

                    <div class="mt-2 text-sm font-medium text-danger">
                        {{ form_errors(registrationForm.email) }}
                    </div>
                </div>

                <div>
                    {{ form_label(registrationForm.plainPassword.first, null, {
                        label_attr: {
                            class: 'mb-2 block text-sm font-medium text-state'
                        }
                    }) }}

                    {{ form_widget(registrationForm.plainPassword.first, {
                        attr: {
                            class: 'w-full rounded-xl border bg-white px-4 py-3 text-state outline-none transition placeholder:text-state '
                                ~ (registrationForm.plainPassword.first.vars.errors|length
                                    ? 'border-danger focus:border-danger focus:ring-2 focus:ring-danger'
                                    : 'border-state focus:border-primary focus:ring-2 focus:ring-primary')
                        }
                    }) }}

                    <div class="mt-2 text-sm font-medium text-danger">
                        {{ form_errors(registrationForm.plainPassword.first) }}
                    </div>
                </div>

                <div>
                    {{ form_label(registrationForm.plainPassword.second, null, {
                        label_attr: {
                            class: 'mb-2 block text-sm font-medium text-state'
                        }
                    }) }}

                    {{ form_widget(registrationForm.plainPassword.second, {
                        attr: {
                            class: 'w-full rounded-xl border bg-white px-4 py-3 text-state outline-none transition placeholder:text-state '
                                ~ (registrationForm.plainPassword.second.vars.errors|length
                                    ? 'border-danger focus:border-danger focus:ring-2 focus:ring-danger'
                                    : 'border-state focus:border-primary focus:ring-2 focus:ring-primary')
                        }
                    }) }}

                    <div class="mt-2 text-sm font-medium text-danger">
                        {{ form_errors(registrationForm.plainPassword.second) }}
                    </div>
                </div>

                <button
                    type="submit"
                    class="w-full rounded-xl bg-secondary py-3 font-semibold text-white transition hover:opacity-90"
                >
                    {{ 'register.submit'|trans }}
                </button>

            {{ form_end(registrationForm) }}

            <div class="mt-6 text-center text-sm text-state">
                {{ 'register.already_account'|trans }}

                <a
                    href="{{ path('app_login') }}"
                    class="font-semibold text-secondary transition-colors hover:text-primary hover:underline"
                >
                    {{ 'register.login'|trans }}
                </a>
            </div>

        </div>
    </main>

    <aside class="hidden lg:block lg:w-1/2">
        <div class="relative h-screen w-full overflow-hidden">
            <div class="embla login-carousel h-full w-full">
                <div class="embla__viewport h-full w-full">
                    <div class="embla__container flex h-full w-full">
                        <div class="embla__slide h-full w-full shrink-0">
                            <img
                                src="{{ asset('build/images/LOGINBG1.jpeg') }}"
                                alt=""
                                class="h-full w-full object-cover"
                            >
                        </div>
                        <div class="embla__slide h-full w-full shrink-0">
                            <img
                                src="{{ asset('build/images/LOGINBG2.jpeg') }}"
                                alt=""
                                class="h-full w-full object-cover"
                            >
                        </div>
                        <div class="embla__slide h-full w-full shrink-0">
                            <img
                                src="{{ asset('build/images/LOGINBG3.jpeg') }}"
                                alt=""
                                class="h-full w-full object-cover"
                            >
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </aside>

</div>
{% endblock %}