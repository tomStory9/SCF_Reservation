{% extends 'base.html.twig' %}

{% trans_default_domain 'login' %}

{% block title %}{{ 'login.title'|trans }}{% endblock %}
{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('carousel') }}
{% endblock %}
{% block body %}

<div class="flex min-h-dvh overflow-x-hidden bg-white lg:h-dvh lg:overflow-hidden">

    <main class="flex min-h-dvh w-full min-w-0 overflow-x-hidden px-4 pb-8 pt-24 sm:px-6 lg:h-dvh lg:min-h-0 lg:w-1/2 lg:overflow-y-auto lg:p-8">

        <div class="mx-auto my-auto w-full min-w-0 max-w-lg">

            <div class="mb-4 flex items-center justify-center gap-3 sm:mb-6 sm:gap-4">

                <img
                    src="{{ asset('build/images/scf.svg') }}"
                    alt="{{ 'app.logo_1'|trans({}, 'messages') }}"
                    class="h-11 w-auto max-w-[45%] sm:h-14"
                >

                <img
                    src="{{ asset('build/images/kitokuras.svg') }}"
                    alt="{{ 'app.logo_2'|trans({}, 'messages') }}"
                    class="h-11 w-auto max-w-[45%] sm:h-14"
                >

            </div>

            <div class="mb-4 text-center sm:mb-6">

                <h1 class="text-2xl font-bold text-primary sm:text-3xl">
                    {{ 'login.title'|trans }}
                </h1>

                <p class="mt-2 text-secondary">
                    {{ 'login.subtitle'|trans }}
                </p>

            </div>

            {# Flash messages #}

            {% set flashes = app.flashes %}

            {% if flashes is not empty %}

                <div class="mb-4 space-y-3 sm:mb-6">

                    {% for label, messages in flashes %}

                        {% for message in messages %}

                            <div
                                class="flex min-w-0 items-start gap-3 rounded-2xl border p-3 sm:gap-4 sm:p-4

                                {% if label == 'success' %}
                                    border-primary/30 bg-primary/10

                                {% elseif label == 'error' %}
                                    border-danger bg-danger/10

                                {% elseif label == 'warning' %}
                                    border-amber-200 bg-amber-50

                                {% else %}
                                    border-secondary/20 bg-secondary/5

                                {% endif %}
                            ">

                                <div
                                    class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full font-bold sm:h-10 sm:w-10

                                    {% if label == 'success' %}
                                        bg-primary text-secondary

                                    {% elseif label == 'error' %}
                                        bg-danger text-white

                                    {% elseif label == 'warning' %}
                                        bg-amber-100 text-amber-700

                                    {% else %}
                                        bg-secondary text-white

                                    {% endif %}
                                ">

                                    {% if label == 'success' %}
                                        ✓
                                    {% elseif label == 'error' %}
                                        !
                                    {% elseif label == 'warning' %}
                                        !
                                    {% else %}
                                        i
                                    {% endif %}

                                </div>

                                <p
                                    class="auth-message min-w-0 flex-1 text-sm leading-6

                                    {% if label == 'success' %}
                                        text-secondary

                                    {% elseif label == 'error' %}
                                        text-danger

                                    {% elseif label == 'warning' %}
                                        text-amber-700

                                    {% else %}
                                        text-secondary

                                    {% endif %}
                                ">
                                    {{ message|trans }}
                                </p>

                            </div>

                        {% endfor %}

                    {% endfor %}

                </div>

            {% endif %}

            {# Login error #}

            {% if error %}

                <div class="mb-4 sm:mb-6">

                    <div class="flex min-w-0 items-start gap-3 rounded-2xl border border-danger bg-danger/10 p-3 sm:gap-4 sm:p-4">

                        <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-danger font-bold text-white sm:h-10 sm:w-10">
                            !
                        </div>

                        <p class="auth-message min-w-0 flex-1 text-sm font-medium leading-6 text-danger">
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </p>

                    </div>

                </div>

            {% endif %}

            <div class="mb-4 grid min-w-0 grid-cols-2 gap-3 sm:mb-6">

                <a
                    href="{{ path('connect_google') }}"
                    class="group flex h-12 items-center justify-center gap-3 rounded-xl border border-state bg-white transition hover:border-primary hover:bg-primary/5"
                >

                    <img
                        src="{{ asset('build/images/Google_G_logo.svg') }}"
                        alt="Google"
                        class="h-5 w-5"
                    >

                    <span class="font-medium text-secondary transition-colors group-hover:text-primary">
                        Google
                    </span>

                </a>

                <a
                    href="{{ path('connect_line') }}"
                    class="group flex h-12 items-center justify-center gap-3 rounded-xl border border-state bg-white transition hover:border-primary hover:bg-primary/5"
                >

                    <img
                        src="{{ asset('build/images/LINE_logo.svg') }}"
                        alt="LINE"
                        class="h-5 w-5"
                    >

                    <span class="font-medium text-secondary transition-colors group-hover:text-primary">
                        LINE
                    </span>

                </a>

            </div>

            <div class="relative mb-4 sm:mb-6">

                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-state"></div>
                </div>

                <div class="relative flex justify-center">

                    <span class="bg-white px-3 text-sm text-state">
                        {{ 'login.or_continue_with'|trans }}
                    </span>

                </div>

            </div>

            <form method="post" class="space-y-4">

                <input
                    type="hidden"
                    name="_csrf_token"
                    value="{{ csrf_token('authenticate') }}"
                >

                <div>

                    <label
                        for="username"
                        class="mb-2 block text-sm font-medium text-state"
                    >
                        {{ 'login.email'|trans({}, 'forms') }}
                    </label>

                    <input
                        id="username"
                        name="email"
                        type="email"
                        value="{{ last_username }}"
                        autocomplete="email"
                        autofocus
                        required
                        placeholder="{{ 'login.email_placeholder'|trans({}, 'forms') }}"
                        class="min-w-0 w-full rounded-xl border bg-white px-4 py-3 text-state outline-none transition placeholder:text-state {{ error ? 'border-danger focus:border-danger focus:ring-2 focus:ring-danger' : 'border-state focus:border-primary focus:ring-2 focus:ring-primary' }}"
                    >

                </div>
                                <div>

                    <label
                        for="password"
                        class="mb-2 block text-sm font-medium text-state"
                    >
                        {{ 'login.password'|trans({}, 'forms') }}
                    </label>

                    <input
                        id="password"
                        name="_password"
                        type="password"
                        autocomplete="current-password"
                        required
                        placeholder="{{ 'login.password_placeholder'|trans({}, 'forms') }}"
                        class="min-w-0 w-full rounded-xl border bg-white px-4 py-3 text-state outline-none transition placeholder:text-state {{ error ? 'border-danger focus:border-danger focus:ring-2 focus:ring-danger' : 'border-state focus:border-primary focus:ring-2 focus:ring-primary' }}"
                    >

                </div>

                <div class="flex flex-wrap items-center justify-between gap-3 text-sm">

                    <label class="flex min-w-0 items-center gap-2">

                        <input
                            type="checkbox"
                            name="_remember_me"
                            class="rounded border-state text-primary focus:ring-primary"
                        >

                        <span class="text-state">
                            {{ 'login.remember_me'|trans }}
                        </span>

                    </label>

                    <a
                        href="{{ path('app_forgot_password_request') }}"
                        class="text-right font-medium text-secondary transition-colors hover:text-primary hover:underline"
                    >
                        {{ 'login.forgot_password'|trans }}
                    </a>

                </div>

                <button
                    type="submit"
                    class="w-full rounded-xl bg-secondary py-3 font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-secondary/90 hover:shadow-lg"
                >
                    {{ 'login.submit'|trans }}
                </button>

            </form>

            <div class="mt-6 text-center text-sm text-state sm:mt-8">

                {{ 'login.no_account'|trans }}

                <a
                    href="{{ path('app_register') }}"
                    class="ml-1 font-semibold text-secondary transition-colors hover:text-primary hover:underline"
                >
                    {{ 'login.create_account'|trans }}
                </a>

            </div>

        </div>

    </main>

    <aside class="hidden lg:block lg:h-dvh lg:w-1/2">
        <div class="relative h-full w-full overflow-hidden">
            <div class="embla login-carousel h-full w-full">
                <div class="embla__viewport h-full w-full">
                    <div class="embla__container flex h-full w-full">
                        <div class="embla__slide h-full w-full shrink-0">
                            <img
                                src="{{ asset('build/images/LOGINBG1.jpeg') }}"
                                alt=""
                                class="h-full w-full object-cover"
                            >
                        </div>
                        <div class="embla__slide h-full w-full shrink-0">
                            <img
                                src="{{ asset('build/images/LOGINBG2.jpeg') }}"
                                alt=""
                                class="h-full w-full object-cover"
                            >
                        </div>
                        <div class="embla__slide h-full w-full shrink-0">
                            <img
                                src="{{ asset('build/images/LOGINBG3.jpeg') }}"
                                alt=""
                                class="h-full w-full object-cover"
                            >
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </aside>

</div>


{% endblock %}
