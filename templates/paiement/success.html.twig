{% extends 'base.html.twig' %}

{% block title %}{{ 'payment.success.title'|trans }}{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-slate-50 px-4 py-10">
    <div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-10 shadow-lg">
        <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-green-100">
            <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
        </div>

        <h1 class="text-center text-2xl font-semibold text-slate-900">
            {{ 'payment.success.title'|trans }}
        </h1>

        <p class="mt-4 text-center text-slate-600">
            {{ 'payment.success.message'|trans }}
        </p>

        <p class="mt-8 text-center text-sm text-slate-500">
            {{ 'payment.success.close_page'|trans }}
        </p>
    </div>
</div>
{% endblock %}