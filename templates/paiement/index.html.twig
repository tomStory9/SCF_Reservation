{% extends 'base.html.twig' %}

{% block title %}{{ 'scaffold.title'|trans({'%controller%': 'PaiementController'}) }}{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>{{ 'scaffold.title'|trans({'%controller%': controller_name}) }} ✅</h1>

    {{ 'scaffold.intro'|trans }}
    <ul>
        <li>{{ 'scaffold.controller_path'|trans }} <code>/app/src/Controller/PaiementController.php</code></li>
        <li>{{ 'scaffold.template_path'|trans }} <code>/app/templates/paiement/index.html.twig</code></li>
    </ul>
</div>
{% endblock %}
