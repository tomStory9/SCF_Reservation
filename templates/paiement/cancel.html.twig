{% extends 'base.html.twig' %}

{% trans_default_domain 'paiement' %}

{% block title %}
    {{ 'paiement.cancel.title'|trans }}
{% endblock %}

{% block body %}
    <main class="min-h-screen flex items-center justify-center bg-slate-50 px-4 py-10">
        <section
            class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-8 shadow-lg sm:p-10"
            aria-labelledby="payment-cancel-title"
        >
            <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-red-100">
                <svg
                    class="h-8 w-8 text-red-600"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </div>

            <h1 id="payment-cancel-title" class="text-center text-2xl font-semibold tracking-tight text-slate-900">
                {{ 'paiement.cancel.title'|trans }}
            </h1>

            <p class="mt-4 text-center text-slate-600">
                {{ 'paiement.cancel.message'|trans }}
            </p>

            <p class="mt-8 text-center text-sm text-slate-500">
                {{ 'paiement.cancel.close_page'|trans }}
            </p>
        </section>
    </main>
{% endblock %}