{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}
    <style>
        .monthly-bookings-modal .modal-dialog {
            max-width: min(1140px, calc(100vw - 2rem));
        }

        .monthly-bookings-modal .modal-content {
            width: 100%;
            max-width: 100%;
            max-height: 90vh;
            overflow: hidden;
        }

        .monthly-bookings-modal .modal-body {
            min-width: 0;
            overflow-x: hidden !important;
            overflow-y: auto;
        }

        .monthly-bookings-modal .row {
            margin-right: 0;
            margin-left: 0;
        }

        .monthly-bookings-modal .row > * {
            min-width: 0;
        }

        .monthly-bookings-modal .monthly-bookings-table-wrapper {
            width: 100%;
            max-width: 100%;
            overflow: hidden;
        }

        .monthly-bookings-modal .monthly-bookings-table {
            width: 100%;
            max-width: 100%;
            margin-bottom: 0;
            table-layout: fixed;
        }

        .monthly-bookings-modal .monthly-bookings-table th,
        .monthly-bookings-modal .monthly-bookings-table td {
            min-width: 0;
            overflow-wrap: anywhere;
            word-break: break-word;
            white-space: normal;
        }

        .monthly-bookings-modal .monthly-bookings-table th:nth-child(1),
        .monthly-bookings-modal .monthly-bookings-table td:nth-child(1) {
            width: 20%;
        }

        .monthly-bookings-modal .monthly-bookings-table th:nth-child(2),
        .monthly-bookings-modal .monthly-bookings-table td:nth-child(2) {
            width: 20%;
        }

        .monthly-bookings-modal .monthly-bookings-table th:nth-child(3),
        .monthly-bookings-modal .monthly-bookings-table td:nth-child(3) {
            width: 18%;
        }

        .monthly-bookings-modal .monthly-bookings-table th:nth-child(4),
        .monthly-bookings-modal .monthly-bookings-table td:nth-child(4) {
            width: 25%;
        }

        .monthly-bookings-modal .monthly-bookings-table th:nth-child(5),
        .monthly-bookings-modal .monthly-bookings-table td:nth-child(5) {
            width: 17%;
        }
    </style>

    <div
        class="modal d-block monthly-bookings-modal"
        tabindex="-1"
        role="dialog"
        style="background: rgba(0, 0, 0, .55);"
    >
        <div
            class="modal-dialog modal-xl modal-dialog-centered"
            role="document"
        >
            <div class="modal-content shadow d-flex flex-column">
                <div class="modal-header">
                    <div>
                        <h4 class="modal-title mb-1">
                            {{ 'admin.monthly.title'|trans }}
                        </h4>

                        <div class="text-muted">
                            {{ user.fullName }}
                        </div>
                    </div>

                    <a
                        href="{{ indexUrl }}"
                        class="btn-close"
                        aria-label="{{ 'admin.monthly.close'|trans }}"
                    ></a>
                </div>

                <div class="modal-body flex-grow-1">
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="card border-0 bg-light h-100">
                                <div class="card-body">
                                    <small class="text-muted">
                                        {{ 'admin.monthly.already_booked_hours'|trans }}
                                    </small>

                                    <h3 class="mb-0">
                                        {{ alreadyBookedHours }} h
                                    </h3>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card border-primary h-100">
                                <div class="card-body">
                                    <small class="text-primary">
                                        {{ 'admin.monthly.current_booking'|trans }}
                                    </small>

                                    <h3 class="mb-0 text-primary">
                                        {{ currentBookingHours }} h
                                    </h3>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        {{ 'admin.monthly.total_after_booking'|trans }}

                        <strong>
                            {{
                                alreadyBookedHours
                                + currentBookingHours
                            }} h
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">
                            {{ 'admin.monthly.list'|trans }}
                        </h5>

                        <span class="badge text-bg-secondary">
                            {{ monthStart|date('m/Y') }}
                        </span>
                    </div>

                    {% if bookings is empty %}
                        <div class="alert alert-secondary">
                            {{ 'admin.monthly.empty'|trans }}
                        </div>
                    {% else %}
                        <div class="monthly-bookings-table-wrapper">
                            <table class="table table-hover align-middle monthly-bookings-table">
                                <thead>
                                    <tr>
                                        <th>{{ 'admin.monthly.date'|trans }}</th>
                                        <th>{{ 'admin.monthly.zone'|trans }}</th>
                                        <th>{{ 'admin.monthly.status'|trans }}</th>
                                        <th>{{ 'admin.monthly.duration'|trans }}</th>
                                        <th>{{ 'admin.monthly.visitors'|trans }}</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    {% for userBooking in bookings %}
                                        {% set bookingId = userBooking.id %}
                                        {% set bookingHours =
                                            hoursByBooking[bookingId]|default(0)
                                        %}

                                        <tr
                                            {% if userBooking.id == booking.id %}
                                                class="table-primary"
                                            {% endif %}
                                        >
                                            <td>
                                                <strong>
                                                    {{ userBooking.startDate|date('d/m/Y') }}
                                                </strong>

                                                <br>

                                                <small class="text-muted">
                                                    {{ userBooking.startDate|date('H:i') }}
                                                    -
                                                    {{ userBooking.endDate|date('H:i') }}
                                                </small>
                                            </td>

                                            <td>
                                                {% if userBooking.zone %}
                                                    {{ userBooking.zone.name }}
                                                {% else %}
                                                    <span class="text-muted">
                                                        {{ 'admin.monthly.unknown_zone'|trans }}
                                                    </span>
                                                {% endif %}
                                            </td>

                                            <td>
                                                {% if userBooking.bookingStatus.value == 'pending' %}
                                                    <span class="badge text-bg-warning">
                                                        {{ 'admin.enum.booking_status.pending'|trans }}
                                                    </span>
                                                {% elseif userBooking.bookingStatus.value == 'approved' %}
                                                    <span class="badge text-bg-success">
                                                        {{ 'admin.enum.booking_status.approved'|trans }}
                                                    </span>
                                                {% elseif userBooking.bookingStatus.value == 'declined' %}
                                                    <span class="badge text-bg-danger">
                                                        {{ 'admin.enum.booking_status.declined'|trans }}
                                                    </span>
                                                {% else %}
                                                    <span class="badge text-bg-secondary">
                                                        {{
                                                            (
                                                                'admin.enum.booking_status.'
                                                                ~ userBooking.bookingStatus.value
                                                            )|trans
                                                        }}
                                                    </span>
                                                {% endif %}
                                            </td>

                                            <td>
                                                <strong>
                                                    {{ bookingHours }} h
                                                </strong>

                                                {% if userBooking.id == booking.id %}
                                                    <br>

                                                    <small class="text-primary">
                                                        {{ 'admin.monthly.current_booking'|trans }}
                                                    </small>
                                                {% endif %}
                                            </td>

                                            <td>
                                                {{ userBooking.guestCount }}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>

                <div class="modal-footer">
                    <a
                        href="{{ indexUrl }}"
                        class="btn btn-secondary"
                    >
                        {{ 'admin.monthly.back'|trans }}
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}