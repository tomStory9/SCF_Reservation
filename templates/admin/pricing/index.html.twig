{% extends '@EasyAdmin/crud/index.html.twig' %}

{% block main %}
    {% set current_day = app.request.query.get('day', 1) %}
    {% set days = {
        1: 'admin.enum.week_day.monday',
        2: 'admin.enum.week_day.tuesday',
        3: 'admin.enum.week_day.wednesday',
        4: 'admin.enum.week_day.thursday',
        5: 'admin.enum.week_day.friday',
        6: 'admin.enum.week_day.saturday',
        7: 'admin.enum.week_day.sunday'
    } %}

    <div class="nav-tabs-custom mb-4">
        <ul class="nav nav-tabs">
            {% for number, label in days %}
                {% set is_active = (current_day == number) %}
                {% set url = ea_url().set('day', number) %}

                <li class="nav-item">
                    <a class="nav-link {% if is_active %}active font-weight-bold{% endif %}" href="{{ url }}">
                        {{ label|trans }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>

    {{ parent() }}
{% endblock %}
