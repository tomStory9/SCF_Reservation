{% extends 'base.html.twig' %}

{% trans_default_domain 'profile' %}

{% block title %}{{ 'account.dashboard.title'|trans }}{% endblock %}

{% block locale_switcher %}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('member_dashboard') }}
{% endblock %}

{% block body %}
    {% set dateFormat = app.request.locale == 'ja' ? 'Y/m/d' : 'd/m/Y' %}
    {% set filterQuery = {'scope': filters.scope, 'status': filters.status} %}

    <div class="member-page">
        <a href="#member-main" class="member-skip-link">{{ 'account.dashboard.skip_to_content'|trans }}</a>

        {% include 'user/_partials/_navbar.html.twig' %}

        <main id="member-main" class="member-main">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="member-flash member-flash--{{ type }}" role="status">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6"/>
                        </svg>
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <section class="member-hero" aria-labelledby="member-dashboard-title">
                <div class="member-hero__content">
                    <h1 id="member-dashboard-title">{{ 'account.dashboard.dashboard_heading'|trans }}</h1>
                    <p class="member-hero__intro">{{ 'account.dashboard.welcome_subtitle'|trans }}</p>
                </div>

                <div class="member-hero__actions">
                    <a href="{{ path('app_booking_index') }}" class="member-reservation-link">
                        <span class="member-reservation-link__icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 7v10M3 9v6m15-8v10m3-8v6M6 12h12"/>
                            </svg>
                        </span>
                        <span>{{ 'account.dashboard.new_booking'|trans }}</span>
                        <svg class="member-reservation-link__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/>
                        </svg>
                    </a>

                    {% if is_granted('FEATURE_ROOM_BOOKING') %}
                        <a href="{{ path('app_room_booking') }}" class="member-reservation-link">
                            <span class="member-reservation-link__icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 19v-8m18 8v-6a2 2 0 0 0-2-2H9a3 3 0 0 0-3 3v1m0 0h15M7 8a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z"/>
                                </svg>
                            </span>
                            <span>{{ 'account.dashboard.new_room_booking'|trans }}</span>
                            <svg class="member-reservation-link__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/>
                            </svg>
                        </a>
                    {% endif %}
                </div>
            </section>

            <section class="member-summary" aria-label="{{ 'account.dashboard.summary_label'|trans }}">
                <article class="member-stat">
                    <div class="member-stat__top">
                        <span class="member-stat__icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3M5 11h14M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z"/></svg>
                        </span>
                        <strong class="member-stat__value">{{ summary.upcoming }}</strong>
                    </div>
                    <p class="member-stat__label">{{ 'account.dashboard.stat_upcoming'|trans }}</p>
                    <p class="member-stat__hint">{{ 'account.dashboard.stat_upcoming_hint'|trans }}</p>
                </article>

                <article class="member-stat">
                    <div class="member-stat__top">
                        <span class="member-stat__icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 7v5l3 2"/></svg>
                        </span>
                        <strong class="member-stat__value">{{ summary.pending }}</strong>
                    </div>
                    <p class="member-stat__label">{{ 'account.dashboard.stat_pending'|trans }}</p>
                    <p class="member-stat__hint">{{ 'account.dashboard.stat_pending_hint'|trans }}</p>
                </article>

                <article class="member-stat">
                    <div class="member-stat__top">
                        <span class="member-stat__icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path stroke-linecap="round" d="M3 10h18M16 15h2"/></svg>
                        </span>
                        <strong class="member-stat__value">{{ summary.paymentDue }}</strong>
                    </div>
                    <p class="member-stat__label">{{ 'account.dashboard.stat_payment_due'|trans }}</p>
                    <p class="member-stat__hint">{{ 'account.dashboard.stat_payment_due_hint'|trans }}</p>
                </article>

                <article class="member-stat">
                    <div class="member-stat__top">
                        <span class="member-stat__icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 4 4L19 6"/><circle cx="12" cy="12" r="9"/></svg>
                        </span>
                        <strong class="member-stat__value">{{ summary.paid }}</strong>
                    </div>
                    <p class="member-stat__label">{{ 'account.dashboard.stat_paid'|trans }}</p>
                    <p class="member-stat__hint">{{ 'account.dashboard.stat_paid_hint'|trans({'%total%': summary.total}) }}</p>
                </article>
            </section>

            <section class="member-reservations" aria-labelledby="booking-list-title">
                <div class="member-section-heading">
                    <div>
                        <h2 id="booking-list-title">{{ 'account.dashboard.booking_list'|trans }}</h2>
                        <p>{{ 'account.dashboard.booking_list_subtitle'|trans }}</p>
                    </div>
                    <span class="member-result-count">{{ 'account.dashboard.result_count'|trans({'%count%': pagination.total}) }}</span>
                </div>

                <nav class="member-tabs" aria-label="{{ 'account.dashboard.scope_label'|trans }}">
                    {% for scope in ['upcoming', 'past', 'all'] %}
                        <a
                            href="{{ path('app_home_user', filterQuery|merge({'scope': scope, 'page': 1})) }}"
                            class="member-tab {{ filters.scope == scope ? 'is-active' : '' }}"
                            {% if filters.scope == scope %}aria-current="page"{% endif %}
                        >{{ ('account.dashboard.scope_' ~ scope)|trans }}</a>
                    {% endfor %}
                </nav>

                <form method="get" action="{{ path('app_home_user') }}" class="member-filters">
                    <input type="hidden" name="scope" value="{{ filters.scope }}">

                    <div class="member-field">
                        <label for="booking-status">{{ 'account.dashboard.status_filter_label'|trans }}</label>
                        <select id="booking-status" name="status" data-auto-submit>
                            <option value="">{{ 'account.dashboard.status_all'|trans }}</option>
                            {% for status in ['pending', 'approved', 'paid', 'declined'] %}
                                <option value="{{ status }}" {{ filters.status == status ? 'selected' : '' }}>{{ ('booking.status.' ~ status)|trans }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    {% if filters.status %}
                        <div class="member-filter-actions">
                            <a href="{{ path('app_home_user', {'scope': filters.scope}) }}" class="member-filter-reset">{{ 'account.dashboard.reset_filters'|trans }}</a>
                        </div>
                    {% endif %}
                </form>

                {% if bookings is empty %}
                    <div class="member-empty">
                        <span class="member-empty__icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3M5 11h14M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z"/></svg>
                        </span>

                        {% if summary.total == 0 %}
                            <h3>{{ 'account.dashboard.no_booking_title'|trans }}</h3>
                            <p>{{ 'account.dashboard.no_booking_text'|trans }}</p>
                            <a href="{{ path('app_booking_index') }}" class="member-button member-button--gold">{{ 'account.dashboard.new_booking'|trans }}</a>
                        {% else %}
                            <h3>{{ 'account.dashboard.no_result_title'|trans }}</h3>
                            <p>{{ 'account.dashboard.no_result_text'|trans }}</p>
                            <a href="{{ path('app_home_user') }}" class="member-button member-button--outline">{{ 'account.dashboard.show_all_bookings'|trans }}</a>
                        {% endif %}
                    </div>
                {% else %}
                    <div class="member-booking-list">
                        {% for booking in bookings %}
                            {% set status = booking.bookingStatus.value %}
                            {% set modalId = 'booking-details-' ~ booking.id %}

                            <article class="member-booking">
                                <time class="member-booking__date" datetime="{{ booking.startDate|date('c') }}">
                                    <span class="member-booking__day">{{ booking.startDate|date('d') }}</span>
                                    <span class="member-booking__month">{{ booking.startDate|date('m') }}</span>
                                    <span class="member-booking__year">{{ booking.startDate|date('Y') }}</span>
                                </time>

                                <div class="member-booking__main">
                                    <div class="member-booking__heading">
                                        <h3>{{ booking.zone.name ?? ('account.dashboard.location_unavailable'|trans) }}</h3>
                                        <span class="member-status member-status--{{ status }}">{{ ('booking.status.' ~ status)|trans }}</span>
                                    </div>

                                    <p class="member-booking__facility">
                                        {% if booking.zone.facility %}{{ booking.zone.facility.name }} · {% endif %}
                                        {{ ('admin.enum.zone_type.' ~ booking.zone.typeZone.value)|trans({}, 'messages') }}
                                        · {{ 'account.dashboard.booking_reference'|trans({'%id%': booking.id}) }}
                                    </p>

                                    <div class="member-booking__meta">
                                        <span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 7v5l3 2"/></svg>
                                            {{ booking.isFullDay ? '09:00–21:00' : booking.startDate|date('H:i') ~ '–' ~ booking.endDate|date('H:i') }}
                                            {% if booking.startDate|date('Ymd') != booking.endDate|date('Ymd') %} · {{ booking.endDate|date(dateFormat) }}{% endif %}
                                        </span>
                                        <span>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                            {{ 'account.dashboard.people_count'|trans({'%count%': booking.guestCount}) }}
                                        </span>
                                        {% if booking.bookingEquipment|length > 0 %}
                                            <span>
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16v13H4zM8 7V4h8v3M9 12h6"/></svg>
                                                {{ 'account.dashboard.equipment_items'|trans({'%count%': booking.bookingEquipment|length}) }}
                                            </span>
                                        {% endif %}
                                    </div>

                                    {% if status == 'pending' %}
                                        <p class="member-booking__note">{{ 'account.dashboard.booking_pending_text'|trans }}</p>
                                    {% elseif status == 'approved' %}
                                        {% if booking.stripeCheckoutUrl %}
                                            <p class="member-booking__note" style="color: #dc2626; font-weight: 600;">
                                                <svg style="display:inline; width:16px; height:16px; vertical-align:text-bottom;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                                {{ 'account.dashboard.fallback_payment_required_text'|trans }}
                                            </p>
                                        {% else %}
                                            <p class="member-booking__note">{{ 'account.dashboard.booking_approved_text'|trans }}</p>
                                        {% endif %}
                                    {% elseif status == 'paid' %}
                                        <p class="member-booking__note">{{ 'account.dashboard.payment_confirmed_text'|trans }}</p>
                                    {% elseif status == 'declined' %}
                                        <p class="member-booking__note">{{ 'account.dashboard.booking_declined_text'|trans }}</p>
                                    {% endif %}
                                </div>

                                <div class="member-booking__aside">
                                    <div>
                                        <div class="member-booking__price-label">{{ 'account.dashboard.total_price'|trans }}</div>
                                        <strong class="member-booking__price">¥{{ (booking.totalPrice ?? booking.price ?? 0)|number_format(0, '.', ',') }}</strong>
                                    </div>

                                    <div class="member-booking__actions">
                                        <button type="button" class="member-button member-button--outline" data-booking-dialog-open="{{ modalId }}">{{ 'account.dashboard.view_details'|trans }}</button>
                                        {% if status == 'approved' and booking.stripeCheckoutUrl %}
                                            <a href="{{ booking.stripeCheckoutUrl }}" target="_blank" rel="noopener noreferrer" class="member-button member-button--navy">{{ 'account.dashboard.pay_now'|trans }}</a>
                                        {% endif %}
                                    </div>
                                </div>
                            </article>

                            <dialog id="{{ modalId }}" class="member-dialog" data-booking-dialog aria-labelledby="{{ modalId }}-title">
                                <div class="member-dialog__header">
                                    <div>
                                        <p class="member-dialog__reference">{{ 'account.dashboard.booking_reference'|trans({'%id%': booking.id}) }}</p>
                                        <h2 id="{{ modalId }}-title">{{ booking.zone.name ?? ('account.dashboard.location_unavailable'|trans) }}</h2>
                                    </div>
                                    <button type="button" class="member-icon-button" data-booking-dialog-close aria-label="{{ 'account.dashboard.close'|trans }}">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6 6 18"/></svg>
                                    </button>
                                </div>

                                <div class="member-dialog__body">
                                    <section class="member-dialog__section">
                                        <h3>{{ 'account.dashboard.booking_information'|trans }}</h3>
                                        <dl class="member-detail-grid">
                                            <div class="member-detail"><dt>{{ 'account.dashboard.status'|trans }}</dt><dd><span class="member-status member-status--{{ status }}">{{ ('booking.status.' ~ status)|trans }}</span></dd></div>
                                            <div class="member-detail"><dt>{{ 'account.dashboard.booking_type'|trans }}</dt><dd>{{ ('admin.enum.zone_type.' ~ booking.zone.typeZone.value)|trans({}, 'messages') }}</dd></div>
                                            <div class="member-detail"><dt>{{ 'account.dashboard.start_date'|trans }}</dt><dd>{{ booking.startDate|date(dateFormat) }} · {{ booking.isFullDay ? '09:00' : booking.startDate|date('H:i') }}</dd></div>
                                            <div class="member-detail"><dt>{{ 'account.dashboard.end_date'|trans }}</dt><dd>{{ booking.endDate|date(dateFormat) }} · {{ booking.isFullDay ? '21:00' : booking.endDate|date('H:i') }}</dd></div>
                                            <div class="member-detail"><dt>{{ 'account.dashboard.number_of_people'|trans }}</dt><dd>{{ booking.guestCount }}</dd></div>
                                            <div class="member-detail"><dt>{{ 'account.dashboard.created_date'|trans }}</dt><dd>{{ booking.createdDate|date(dateFormat ~ ' · H:i') }}</dd></div>
                                        </dl>
                                    </section>

                                    <section class="member-dialog__section">
                                        <h3>{{ 'account.dashboard.facility_details'|trans }}</h3>
                                        <dl class="member-detail-grid">
                                            <div class="member-detail"><dt>{{ 'account.dashboard.facility'|trans }}</dt><dd>{{ booking.zone.facility.name ?? ('account.dashboard.not_available'|trans) }}</dd></div>
                                            <div class="member-detail"><dt>{{ 'account.dashboard.booking_mode'|trans }}</dt><dd>{{ booking.isFullDay ? ('account.dashboard.full_day'|trans) : ('account.dashboard.partial_day'|trans) }}</dd></div>
                                        </dl>
                                    </section>

                                    <section class="member-dialog__section">
                                        <h3>{{ 'account.dashboard.reserved_equipment'|trans }}</h3>
                                        {% if booking.bookingEquipment is empty %}
                                            <div class="member-detail">{{ 'account.dashboard.no_reserved_equipment'|trans }}</div>
                                        {% else %}
                                            <div class="member-equipment-list">
                                                {% for bookingEquipment in booking.bookingEquipment %}
                                                    <div class="member-equipment-row">
                                                        <div>
                                                            <strong>{{ bookingEquipment.equipment.name ?? ('account.dashboard.equipment'|trans) }}</strong>
                                                            <small>{{ 'account.dashboard.quantity'|trans }}: {{ bookingEquipment.quantity }}</small>
                                                        </div>
                                                        <strong>¥{{ bookingEquipment.totalPrice|number_format(0, '.', ',') }}</strong>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    </section>

                                    <section class="member-dialog__section">
                                        <h3>{{ 'account.dashboard.price_summary'|trans }}</h3>
                                        <div class="member-price-summary">
                                            <div><span>{{ 'account.dashboard.booking_price'|trans }}</span><strong>¥{{ (booking.price ?? 0)|number_format(0, '.', ',') }}</strong></div>
                                            <div><span>{{ 'account.dashboard.equipment'|trans }}</span><strong>¥{{ (booking.equipmentPrice ?? 0)|number_format(0, '.', ',') }}</strong></div>
                                            <div class="member-price-summary__total"><span>{{ 'account.dashboard.total'|trans }}</span><strong>¥{{ (booking.totalPrice ?? booking.price ?? 0)|number_format(0, '.', ',') }}</strong></div>
                                        </div>
                                    </section>
                                </div>

                                <div class="member-dialog__footer">
                                    {% if status == 'approved' and booking.stripeCheckoutUrl %}
                                        <a href="{{ booking.stripeCheckoutUrl }}" target="_blank" rel="noopener noreferrer" class="member-button member-button--gold">{{ 'account.dashboard.proceed_to_payment'|trans }}</a>
                                    {% endif %}
                                    <button type="button" class="member-button member-button--outline" data-booking-dialog-close>{{ 'account.dashboard.close'|trans }}</button>
                                </div>
                            </dialog>
                        {% endfor %}
                    </div>

                    {% if pagination.pages > 1 %}
                        {% set pageStart = max(1, pagination.page - 2) %}
                        {% set pageEnd = min(pagination.pages, pagination.page + 2) %}
                        <div class="member-pagination-wrap">
                            <p class="member-pagination-summary">{{ 'account.dashboard.pagination_summary'|trans({
                                '%start%': ((pagination.page - 1) * pagination.perPage) + 1,
                                '%end%': min(pagination.total, pagination.page * pagination.perPage),
                                '%total%': pagination.total
                            }) }}</p>

                            <nav class="member-pagination" aria-label="{{ 'account.dashboard.pagination_label'|trans }}">
                                {% if pagination.page > 1 %}
                                    <a href="{{ path('app_home_user', filterQuery|merge({'page': pagination.page - 1})) }}" aria-label="{{ 'account.dashboard.previous_page'|trans }}">←</a>
                                {% else %}
                                    <span class="is-disabled" aria-hidden="true">←</span>
                                {% endif %}

                                {% for pageNumber in pageStart..pageEnd %}
                                    {% if pageNumber == pagination.page %}
                                        <span class="is-current" aria-current="page">{{ pageNumber }}</span>
                                    {% else %}
                                        <a href="{{ path('app_home_user', filterQuery|merge({'page': pageNumber})) }}" aria-label="{{ 'account.dashboard.page_number'|trans({'%page%': pageNumber}) }}">{{ pageNumber }}</a>
                                    {% endif %}
                                {% endfor %}

                                {% if pagination.page < pagination.pages %}
                                    <a href="{{ path('app_home_user', filterQuery|merge({'page': pagination.page + 1})) }}" aria-label="{{ 'account.dashboard.next_page'|trans }}">→</a>
                                {% else %}
                                    <span class="is-disabled" aria-hidden="true">→</span>
                                {% endif %}
                            </nav>
                        </div>
                    {% endif %}
                {% endif %}
            </section>
        </main>
    </div>
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('member_dashboard') }}
{% endblock %}
