{% extends 'base.html.twig' %}

{% block title %}
    {{ 'account.dashboard.title'|trans }}
{% endblock %}

{% trans_default_domain 'profile' %}

{% block body %}
    <div class="min-h-screen bg-slate-50 text-slate-900">

        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-xl focus:bg-white focus:px-4 focus:py-2"
        >
            {{ 'account.dashboard.skip_to_content'|trans }}
        </a>

        {% include 'user/_partials/_navbar.html.twig' %}

        <main
            id="main-content"
            class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-6 sm:px-6 lg:px-8"
        >

            {% for message in app.flashes('success') %}
                <div class="rounded-xl border border-green-200 bg-green-50 p-4">
                    <div class="flex items-center">
                        <div class="shrink-0">
                            <svg
                                class="h-5 w-5 text-green-500"
                                viewBox="0 0 20 20"
                                fill="currentColor"
                                aria-hidden="true"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
                                    clip-rule="evenodd"
                                />
                            </svg>
                        </div>

                        <div class="ml-3">
                            <p class="text-sm font-medium text-green-800">
                                {{ message }}
                            </p>
                        </div>
                    </div>
                </div>
            {% endfor %}

            <section class="rounded-[1.75rem] bg-white ring-1 ring-slate-200/70">

                <div class="flex flex-col gap-3 border-b border-slate-200 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
                    <div>
                        <h2 class="text-lg font-semibold text-secondary">
                            {{ 'account.dashboard.booking_list'|trans }}
                        </h2>

                        <p class="mt-1 text-sm text-state">
                            {{ 'account.dashboard.booking_list_subtitle'|trans }}
                        </p>
                    </div>

                    <a
                        href="{{ path('app_home') }}"
                        class="inline-flex min-h-11 items-center justify-center rounded-xl bg-secondary px-4 py-2 text-sm font-medium text-white transition hover:bg-secondary/90"
                    >
                        {{ 'account.dashboard.book_now'|trans }}
                    </a>
                </div>

                {% if bookings is empty %}

                    <div class="flex flex-col items-center justify-center px-6 py-16 text-center">
                        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-secondary/5 text-secondary">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-8 w-8"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="1.6"
                                    d="M8 7V3m8 4V3m-9 8h10m-12 9h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v11a2 2 0 002 2z"
                                />
                            </svg>
                        </div>

                        <h3 class="mt-5 text-lg font-semibold text-secondary">
                            {{ 'account.dashboard.no_booking_title'|trans }}
                        </h3>

                        <p class="mt-2 max-w-md text-sm text-state">
                            {{ 'account.dashboard.no_booking_text'|trans }}
                        </p>

                        <a
                            href="{{ path('app_home') }}"
                            class="mt-6 inline-flex min-h-11 items-center justify-center rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-secondary transition hover:bg-primary-hover"
                        >
                            {{ 'account.dashboard.new_booking'|trans }}
                        </a>
                    </div>

                {% else %}

                    <div class="flex flex-col divide-y divide-slate-200">

                        {% for booking in bookings %}

                            {% set status = booking.bookingStatus.value|upper %}
                            {% set modalId = 'booking-details-' ~ booking.id %}

                            {% set statusClasses = {
                                'PENDING': 'bg-amber-100 text-amber-800',
                                'APPROVED': 'bg-indigo-100 text-indigo-800',
                                'CONFIRMED': 'bg-green-100 text-green-800',
                                'PAID': 'bg-emerald-100 text-emerald-800',
                                'CANCELLED': 'bg-rose-100 text-rose-800',
                                'COMPLETED': 'bg-blue-100 text-blue-800'
                            } %}

                            <article class="px-5 py-5 sm:px-6">
                                <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">

                                    <div class="min-w-0 flex-1">

                                        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                                            <div class="min-w-0">

                                                <div class="flex flex-wrap items-center gap-2">
                                                    <h3 class="text-base font-semibold text-secondary sm:text-lg">
                                                        {{ booking.zone.name ?? ('account.dashboard.location_unavailable'|trans) }}
                                                    </h3>

                                                    <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold {{ statusClasses[status] ?? 'bg-slate-100 text-slate-700' }}">
                                                        {{ ('booking.status.' ~ status)|trans }}
                                                    </span>

                                                    <span class="inline-flex items-center rounded-full bg-primary/15 px-3 py-1 text-xs font-semibold text-secondary">
                                                        {{ booking.guestCount }}
                                                        {{ 'account.dashboard.guests'|trans }}
                                                    </span>
                                                </div>

                                                <p class="mt-2 text-sm text-state">
                                                    {{ 'account.dashboard.booking'|trans }}
                                                    #{{ booking.id }}
                                                </p>

                                                <div class="mt-4 rounded-2xl border border-secondary/10 bg-secondary/5 px-4 py-3">
                                                    <p class="text-xs font-medium uppercase tracking-wide text-state">
                                                        {{ 'account.dashboard.stay_period'|trans }}
                                                    </p>

                                                    <p class="mt-1 text-sm font-semibold text-secondary sm:text-base">
                                                        {{ 'account.dashboard.from'|trans }}

                                                        {{ booking.startDate
                                                            ? booking.startDate|date('d/m/Y H:i')
                                                            : '-'
                                                        }}

                                                        <span class="mx-2 text-state">→</span>

                                                        {{ 'account.dashboard.to'|trans }}

                                                        {{ booking.endDate
                                                            ? booking.endDate|date('d/m/Y H:i')
                                                            : '-'
                                                        }}
                                                    </p>
                                                </div>

                                                <div class="mt-4 flex flex-wrap items-center gap-2">
                                                    <span class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-secondary">
                                                        {{
                                                            booking.isFullDay
                                                                ? 'account.dashboard.full_day'|trans
                                                                : 'account.dashboard.partial_day'|trans
                                                        }}
                                                    </span>

                                                    <span class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-secondary">
                                                        {{ booking.bookingEquipment|length }}
                                                        {{ 'account.dashboard.equipment_count'|trans }}
                                                    </span>
                                                </div>

                                                {# Statut PENDING #}
                                                {% if status == 'PENDING' %}
                                                    <div class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 p-4">
                                                        <p class="text-sm font-semibold text-amber-900">
                                                            {{ 'account.dashboard.booking_pending_title'|trans }}
                                                        </p>

                                                        <p class="mt-1 text-sm text-amber-700">
                                                            {{ 'account.dashboard.booking_pending_text'|trans }}
                                                        </p>
                                                    </div>
                                                {% endif %}

                                                {# Statut APPROVED #}
                                                {% if status == 'APPROVED' %}
                                                    <div class="mt-5 rounded-2xl border border-indigo-200 bg-indigo-50 p-4">
                                                        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                                                            <div>
                                                                <p class="text-sm font-semibold text-indigo-900">
                                                                    {{ 'account.dashboard.booking_approved_title'|trans }}
                                                                </p>

                                                                <p class="mt-1 text-sm text-indigo-700">
                                                                    {{ 'account.dashboard.booking_approved_text'|trans }}
                                                                </p>
                                                            </div>

                                                            {% if booking.stripeCheckoutUrl %}
                                                                <a
                                                                    href="{{ booking.stripeCheckoutUrl }}"
                                                                    target="_blank"
                                                                    rel="noopener noreferrer"
                                                                    class="inline-flex min-h-11 items-center justify-center rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700"
                                                                >
                                                                    {{ 'account.dashboard.proceed_to_payment'|trans }}
                                                                </a>
                                                            {% endif %}
                                                        </div>
                                                    </div>
                                                {% endif %}

                                                {# Statut PAID #}
                                                {% if status == 'PAID' %}
                                                    <div class="mt-5 rounded-2xl border border-emerald-200 bg-emerald-50 p-4">
                                                        <div class="flex items-center gap-3">
                                                            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
                                                                <svg
                                                                    xmlns="http://www.w3.org/2000/svg"
                                                                    class="h-5 w-5"
                                                                    viewBox="0 0 24 24"
                                                                    fill="none"
                                                                    stroke="currentColor"
                                                                    stroke-width="2"
                                                                >
                                                                    <path
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        d="m5 12 4 4L19 6"
                                                                    />
                                                                </svg>
                                                            </div>

                                                            <div>
                                                                <p class="text-sm font-semibold text-emerald-900">
                                                                    {{ 'account.dashboard.payment_confirmed_title'|trans }}
                                                                </p>

                                                                <p class="mt-1 text-sm text-emerald-700">
                                                                    {{ 'account.dashboard.payment_confirmed_text'|trans }}
                                                                </p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endif %}

                                                {# Statut CANCELLED #}
                                                {% if status == 'CANCELLED' %}
                                                    <div class="mt-5 rounded-2xl border border-rose-200 bg-rose-50 p-4">
                                                        <p class="text-sm font-semibold text-rose-900">
                                                            {{ 'account.dashboard.booking_cancelled_title'|trans }}
                                                        </p>
                                                    </div>
                                                {% endif %}

                                            </div>
                                        </div>
                                    </div>

                                    <div class="flex shrink-0 flex-col gap-3 lg:items-end">

                                        <div class="rounded-2xl bg-[#fbf5ed] px-4 py-3 text-left lg:min-w-[190px] lg:text-right">
                                            <p class="text-xs font-medium uppercase tracking-wide text-[#7a4b2a]">
                                                {{ 'account.dashboard.total_price'|trans }}
                                            </p>

                                            <p class="mt-1 text-2xl font-bold leading-none text-secondary sm:text-3xl">
                                                ¥{{ (booking.totalPrice ?? booking.price)|number_format(0, '.', ',') }}
                                            </p>

                                            {% if booking.equipmentPrice > 0 %}
                                                <p class="mt-2 text-xs text-[#7a4b2a]">
                                                    {{ 'account.dashboard.including_equipment'|trans }}
                                                    ¥{{ booking.equipmentPrice|number_format(0, '.', ',') }}
                                                </p>
                                            {% endif %}
                                        </div>

                                        <div class="flex flex-col gap-2 sm:flex-row lg:flex-col">

                                            <button
                                                type="button"
                                                onclick="document.getElementById('{{ modalId }}').showModal()"
                                                class="inline-flex min-h-11 items-center justify-center rounded-xl bg-secondary px-4 py-2 text-sm font-medium text-white transition hover:bg-secondary/90"
                                            >
                                                {{ 'account.dashboard.view_details'|trans }}
                                            </button>

                                            {% if status == 'APPROVED' and booking.stripeCheckoutUrl %}
                                                <a
                                                    href="{{ booking.stripeCheckoutUrl }}"
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="inline-flex min-h-11 items-center justify-center rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-2 text-sm font-semibold text-indigo-700 transition hover:bg-indigo-100"
                                                >
                                                    {{ 'account.dashboard.pay_now'|trans }}
                                                </a>
                                            {% elseif status == 'PAID' %}
                                                <span class="inline-flex min-h-11 items-center justify-center rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-700">
                                                    {{ 'account.dashboard.payment_completed'|trans }}
                                                </span>
                                            {% endif %}

                                        </div>
                                    </div>
                                </div>
                            </article>

                            {# Modal des détails #}
                            <dialog
                                id="{{ modalId }}"
                                class="w-[calc(100%-2rem)] max-w-2xl rounded-3xl p-0 shadow-2xl backdrop:bg-slate-900/60"
                            >
                                <div class="overflow-hidden rounded-3xl bg-white">

                                    <div class="flex items-start justify-between border-b border-slate-200 px-5 py-5 sm:px-6">
                                        <div>
                                            <p class="text-xs font-medium uppercase tracking-wide text-state">
                                                {{ 'account.dashboard.booking'|trans }}
                                                #{{ booking.id }}
                                            </p>

                                            <h2 class="mt-1 text-xl font-bold text-secondary">
                                                {{ booking.zone.name ?? ('account.dashboard.location_unavailable'|trans) }}
                                            </h2>
                                        </div>

                                        <button
                                            type="button"
                                            onclick="document.getElementById('{{ modalId }}').close()"
                                            class="rounded-xl p-2 text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
                                            aria-label="{{ 'account.dashboard.close'|trans }}"
                                        >
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-6 w-6"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    d="M6 18 18 6M6 6l12 12"
                                                />
                                            </svg>
                                        </button>
                                    </div>

                                    <div class="max-h-[70vh] space-y-6 overflow-y-auto px-5 py-5 sm:px-6">

                                        {# Informations générales #}
                                        <section>
                                            <h3 class="text-sm font-semibold uppercase tracking-wide text-state">
                                                {{ 'account.dashboard.booking_information'|trans }}
                                            </h3>

                                            <dl class="mt-3 grid gap-3 sm:grid-cols-2">

                                                <div class="rounded-xl bg-slate-50 p-3">
                                                    <dt class="text-xs text-state">
                                                        {{ 'account.dashboard.status'|trans }}
                                                    </dt>

                                                    <dd class="mt-1 text-sm font-semibold text-secondary">
                                                        {{ ('booking.status.' ~ status)|trans }}
                                                    </dd>
                                                </div>

                                                <div class="rounded-xl bg-slate-50 p-3">
                                                    <dt class="text-xs text-state">
                                                        {{ 'account.dashboard.number_of_people'|trans }}
                                                    </dt>

                                                    <dd class="mt-1 text-sm font-semibold text-secondary">
                                                        {{ booking.guestCount }}
                                                    </dd>
                                                </div>

                                                <div class="rounded-xl bg-slate-50 p-3">
                                                    <dt class="text-xs text-state">
                                                        {{ 'account.dashboard.start_date'|trans }}
                                                    </dt>

                                                    <dd class="mt-1 text-sm font-semibold text-secondary">
                                                        {{ booking.startDate
                                                            ? booking.startDate|date('d/m/Y à H:i')
                                                            : '-'
                                                        }}
                                                    </dd>
                                                </div>

                                                <div class="rounded-xl bg-slate-50 p-3">
                                                    <dt class="text-xs text-state">
                                                        {{ 'account.dashboard.end_date'|trans }}
                                                    </dt>

                                                    <dd class="mt-1 text-sm font-semibold text-secondary">
                                                        {{ booking.endDate
                                                            ? booking.endDate|date('d/m/Y à H:i')
                                                            : '-'
                                                        }}
                                                    </dd>
                                                </div>

                                                <div class="rounded-xl bg-slate-50 p-3">
                                                    <dt class="text-xs text-state">
                                                        {{ 'account.dashboard.booking_type'|trans }}
                                                    </dt>

                                                    <dd class="mt-1 text-sm font-semibold text-secondary">
                                                        {{
                                                            booking.isFullDay
                                                                ? 'account.dashboard.full_day'|trans
                                                                : 'account.dashboard.partial_day'|trans
                                                        }}
                                                    </dd>
                                                </div>

                                                <div class="rounded-xl bg-slate-50 p-3">
                                                    <dt class="text-xs text-state">
                                                        {{ 'account.dashboard.created_date'|trans }}
                                                    </dt>

                                                    <dd class="mt-1 text-sm font-semibold text-secondary">
                                                        {{ booking.createdDate
                                                            ? booking.createdDate|date('d/m/Y H:i')
                                                            : '-'
                                                        }}
                                                    </dd>
                                                </div>

                                            </dl>
                                        </section>

                                        {# Équipements réservés #}
                                        <section>
                                            <div class="flex items-center justify-between gap-3">
                                                <h3 class="text-sm font-semibold uppercase tracking-wide text-state">
                                                    {{ 'account.dashboard.reserved_equipment'|trans }}
                                                </h3>

                                                <span class="text-sm font-semibold text-secondary">
                                                    {{ (booking.equipmentPrice ?? 0)|number_format(0, '.', ',') }} ¥
                                                </span>
                                            </div>

                                            {% if booking.bookingEquipment is empty %}

                                                <div class="mt-3 rounded-xl bg-slate-50 p-4 text-sm text-state">
                                                    {{ 'account.dashboard.no_reserved_equipment'|trans }}
                                                </div>

                                            {% else %}

                                                <div class="mt-3 overflow-hidden rounded-2xl border border-slate-200">
                                                    <div class="divide-y divide-slate-200">

                                                        {% for bookingEquipment in booking.bookingEquipment %}
                                                            <div class="flex items-center justify-between gap-4 px-4 py-4">

                                                                <div class="min-w-0">
                                                                    <p class="truncate text-sm font-semibold text-secondary">
                                                                        {{ bookingEquipment.equipment.name ?? ('account.dashboard.equipment'|trans) }}
                                                                    </p>

                                                                    <p class="mt-1 text-xs text-state">
                                                                        {{ 'account.dashboard.quantity'|trans }}
                                                                        : {{ bookingEquipment.quantity }}

                                                                        {% if bookingEquipment.equipment.unitPrice is defined %}
                                                                            · {{ 'account.dashboard.unit_price'|trans }}
                                                                            : {{ bookingEquipment.equipment.unitPrice|number_format(0, '.', ',') }} ¥
                                                                        {% endif %}
                                                                    </p>
                                                                </div>

                                                                <p class="shrink-0 text-sm font-bold text-secondary">
                                                                    {{ bookingEquipment.totalPrice|number_format(0, '.', ',') }} ¥
                                                                </p>
                                                            </div>
                                                        {% endfor %}

                                                    </div>
                                                </div>

                                            {% endif %}
                                        </section>

                                        {# Résumé financier #}
                                        <section class="rounded-2xl bg-[#fbf5ed] p-4">
                                            <h3 class="text-sm font-semibold uppercase tracking-wide text-[#7a4b2a]">
                                                {{ 'account.dashboard.price_summary'|trans }}
                                            </h3>

                                            <dl class="mt-3 space-y-2 text-sm">

                                                <div class="flex items-center justify-between gap-4">
                                                    <dt class="text-[#7a4b2a]">
                                                        {{ 'account.dashboard.booking_price'|trans }}
                                                    </dt>

                                                    <dd class="font-semibold text-secondary">
                                                        {{ (booking.price ?? 0)|number_format(0, '.', ',') }} ¥
                                                    </dd>
                                                </div>

                                                <div class="flex items-center justify-between gap-4">
                                                    <dt class="text-[#7a4b2a]">
                                                        {{ 'account.dashboard.equipment'|trans }}
                                                    </dt>

                                                    <dd class="font-semibold text-secondary">
                                                        {{ (booking.equipmentPrice ?? 0)|number_format(0, '.', ',') }} ¥
                                                    </dd>
                                                </div>

                                                <div class="border-t border-[#d9c2aa] pt-2">
                                                    <div class="flex items-center justify-between gap-4">
                                                        <dt class="font-bold text-[#7a4b2a]">
                                                            {{ 'account.dashboard.total'|trans }}
                                                        </dt>

                                                        <dd class="text-lg font-bold text-secondary">
                                                            {{
                                                                (booking.totalPrice ?? booking.price ?? 0)
                                                                |number_format(0, '.', ',')
                                                            }} ¥
                                                        </dd>
                                                    </div>
                                                </div>

                                            </dl>
                                        </section>

                                    </div>

                                    <div class="flex justify-end border-t border-slate-200 px-5 py-4 sm:px-6">
                                        <button
                                            type="button"
                                            onclick="document.getElementById('{{ modalId }}').close()"
                                            class="inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-secondary transition hover:bg-slate-100"
                                        >
                                            {{ 'account.dashboard.close'|trans }}
                                        </button>
                                    </div>

                                </div>
                            </dialog>

                        {% endfor %}

                    </div>
                {% endif %}

            </section>
        </main>
    </div>
{% endblock %}