{% extends 'base.html.twig' %}
{% trans_default_domain 'profile' %}

{% block title %}
    {{ 'account.dashboard.my_info'|trans }} - SCF
{% endblock %}

{% block body %}
    <div class="min-h-screen overflow-x-hidden bg-slate-50 text-slate-900">
        {% include 'user/_partials/_navbar.html.twig' %}

        <div class="mx-auto w-full max-w-5xl px-4 py-12 sm:px-6 lg:px-8">

            <div class="mb-8 flex flex-col gap-4">
                {% for message in app.flashes('success') %}
                    <div class="rounded-xl border border-green-200 bg-green-50 p-4">
                        <div class="flex items-center">
                            <div class="shrink-0">
                                <svg class="h-5 w-5 text-green-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"></path>
                                </svg>
                            </div>
                            <div class="ml-3">
                                <p class="text-sm font-medium text-green-800">{{ message }}</p>
                            </div>
                        </div>
                    </div>
                {% endfor %}

                {% for message in app.flashes('warning') %}
                    <div class="rounded-xl border border-orange-200 bg-orange-50 p-4">
                        <div class="flex items-center">
                            <div class="shrink-0">
                                <svg class="h-5 w-5 text-orange-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
                                </svg>
                            </div>
                            <div class="ml-3">
                                <p class="text-sm font-medium text-orange-800">{{ message }}</p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <section class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm sm:p-12">

                <div class="mb-14 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-[0.2em] text-state">
                            {{ 'account.profile.section'|trans }}
                        </p>
                        <h2 class="mt-2 text-3xl font-semibold text-secondary">
                            {{ 'account.dashboard.my_info'|trans }}
                        </h2>
                    </div>

                    <a href="{{ path('app_user_profile_edit') }}" class="inline-flex items-center justify-center rounded-xl bg-secondary px-6 py-3 text-sm font-semibold text-white transition hover:bg-secondary/90 hover:shadow-lg">
                        {{ 'account.profile.edit_button'|trans }}
                    </a>
                </div>

                <div class="grid grid-cols-1 gap-x-16 gap-y-12 sm:grid-cols-2">
                    <div>
                        <p class="text-sm font-medium uppercase tracking-wider text-state">
                            {{ 'account.profile.lastname'|trans }}
                        </p>
                        <p class="mt-2 text-xl font-semibold text-secondary">
                            {{ user.lastname }}
                        </p>
                    </div>

                    {# Prénom #}
                    <div>
                        <p class="text-sm font-medium uppercase tracking-wider text-state">
                            {{ 'account.profile.firstname'|trans }}
                        </p>
                        <p class="mt-2 text-xl font-semibold text-secondary">
                            {{ user.name }}
                        </p>
                    </div>

                    {# Email #}
                    <div>
                        <p class="text-sm font-medium uppercase tracking-wider text-state">
                            {{ 'account.profile.email'|trans }}
                        </p>
                        <div class="mt-2 flex flex-wrap items-center gap-4">
                            <p class="text-xl font-semibold text-secondary">
                                {{ user.email }}
                            </p>

                            {% if user.isVerified %}
                                <span class="inline-flex items-center gap-1.5 rounded-md bg-green-50 px-2.5 py-1 text-xs font-bold uppercase tracking-widest text-green-700 ring-1 ring-inset ring-green-600/20">
                                    {{ 'account.profile.verified'|trans }}
                                </span>
                            {% else %}
                                <span class="inline-flex items-center gap-1.5 rounded-md bg-orange-50 px-2.5 py-1 text-xs font-bold uppercase tracking-widest text-orange-700 ring-1 ring-inset ring-orange-600/20">
                                    {{ 'account.profile.pending'|trans }}
                                </span>
                            {% endif %}
                        </div>
                    </div>

                    {# Téléphone #}
                    <div>
                        <p class="text-sm font-medium uppercase tracking-wider text-state">
                            {{ 'account.profile.phone'|trans }}
                        </p>
                        <p class="mt-2 text-xl font-semibold text-secondary">
                            {{ user.phone ?: 'account.profile.not_provided'|trans }}
                        </p>
                    </div>

                    {# Entreprise #}
                    <div class="sm:col-span-2">
                        <p class="text-sm font-medium uppercase tracking-wider text-state">
                            {{ 'account.profile.company'|trans }}
                        </p>
                        <p class="mt-2 text-xl font-semibold text-secondary">
                            {{ user.company ?: 'account.profile.not_provided'|trans }}
                        </p>
                    </div>
                </div>
            </section>
        </div>
    </div>
{% endblock %}
