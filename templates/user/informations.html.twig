{% extends 'base.html.twig' %}
{% trans_default_domain 'profile' %}

{% block title %}
    {{ 'account.dashboard.my_info'|trans }} - SCF
{% endblock %}

{% block body %}
    <div class="min-h-screen overflow-x-hidden bg-slate-50 text-slate-900">
        {% include 'user/_partials/_navbar.html.twig' %}

        <div class="mx-auto w-full max-w-5xl px-4 py-12 sm:px-6 lg:px-8">

            <section class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm sm:p-12">

                <div class="mb-14">
                    <p class="text-xs font-bold uppercase tracking-[0.2em] text-state">
                        {{ 'account.profile.section'|trans }}
                    </p>
                    <h2 class="mt-2 text-3xl font-semibold text-secondary">
                        {{ 'account.dashboard.my_info'|trans }}
                    </h2>
                </div>

                <div class="grid grid-cols-1 gap-x-16 gap-y-12 sm:grid-cols-2">

                    {# Nom #}
                    <div>
                        <p class="text-sm font-medium uppercase tracking-wider text-state">
                            {{ 'account.profile.lastname'|trans }}
                        </p>
                        <p class="mt-2 text-xl font-semibold text-secondary">
                            {{ user.lastname }}
                        </p>
                    </div>

                    {# Prénom #}
                    <div>
                        <p class="text-sm font-medium uppercase tracking-wider text-state">
                            {{ 'account.profile.firstname'|trans }}
                        </p>
                        <p class="mt-2 text-xl font-semibold text-secondary">
                            {{ user.name }}
                        </p>
                    </div>

                    {# Email #}
                    <div>
                        <p class="text-sm font-medium uppercase tracking-wider text-state">
                            {{ 'account.profile.email'|trans }}
                        </p>
                        <div class="mt-2 flex flex-wrap items-center gap-4">
                            <p class="text-xl font-semibold text-secondary">
                                {{ user.email }}
                            </p>

                            {% if user.isVerified %}
                                <span class="inline-flex items-center gap-1.5 rounded-md bg-green-50 px-2.5 py-1 text-xs font-bold uppercase tracking-widest text-green-700 ring-1 ring-inset ring-green-600/20">
                                    {{ 'account.profile.verified'|trans }}
                                </span>
                            {% else %}
                                <span class="inline-flex items-center gap-1.5 rounded-md bg-orange-50 px-2.5 py-1 text-xs font-bold uppercase tracking-widest text-orange-700 ring-1 ring-inset ring-orange-600/20">
                                    {{ 'account.profile.pending'|trans }}
                                </span>
                            {% endif %}
                        </div>
                    </div>

                    {# Téléphone #}
                    <div>
                        <p class="text-sm font-medium uppercase tracking-wider text-state">
                            {{ 'account.profile.phone'|trans }}
                        </p>
                        <p class="mt-2 text-xl font-semibold text-secondary">
                            {{ user.phone ?: 'account.profile.not_provided'|trans }}
                        </p>
                    </div>

                    {# Entreprise #}
                    <div class="sm:col-span-2">
                        <p class="text-sm font-medium uppercase tracking-wider text-state">
                            {{ 'account.profile.company'|trans }}
                        </p>
                        <p class="mt-2 text-xl font-semibold text-secondary">
                            {{ user.company ?: 'account.profile.not_provided'|trans }}
                        </p>
                    </div>

                </div>
            </section>
        </div>
    </div>
{% endblock %}
