{% extends 'base.html.twig' %}

{% block locale_switcher %}{% endblock %}
{% trans_default_domain 'profile' %}

{% block title %}
    {{ 'account.profile.edit_title'|trans }} - SCF
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('user-profile') }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('user-profile') }}
{% endblock %}

{% macro form_field(field) %}
    <div>
        {{ form_label(field, null, {'label_attr': {'class': 'text-sm font-medium uppercase tracking-wider text-state'}}) }}
        {{ form_widget(field, {'attr': {'class': 'mt-2 block w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-lg font-medium text-secondary transition-colors focus:border-secondary focus:bg-white focus:ring-secondary'}}) }}
        <div class="text-sm text-red-500 mt-1">{{ form_errors(field) }}</div>
    </div>
{% endmacro %}

{% block body %}
    <div class="min-h-screen overflow-x-hidden bg-slate-50 text-slate-900">
        {% include 'user/_partials/_navbar.html.twig' %}

        <div class="mx-auto w-full max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
            <section class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm sm:p-12">

                <div class="mb-14">
                    <p class="text-xs font-bold uppercase tracking-[0.2em] text-state">
                        {{ 'account.profile.section'|trans }}
                    </p>
                    <h2 class="mt-2 text-3xl font-semibold text-secondary">
                        {{ 'account.profile.edit_title'|trans }}
                    </h2>
                </div>

                {{ form_start(form, {'attr': {'class': 'space-y-12'}}) }}

                <div class="grid grid-cols-1 gap-x-16 gap-y-10 sm:grid-cols-2">

                    {# Identité & Contact #}
                    {{ _self.form_field(form.lastname) }}
                    {{ _self.form_field(form.name) }}
                    {{ _self.form_field(form.email) }}
                    {{ _self.form_field(form.phone) }}
                    {{ _self.form_field(form.birthDate) }}
                    {{ _self.form_field(form.nationalitie) }}

                    <div class="sm:col-span-2">
                        {{ _self.form_field(form.residenceCity) }}
                    </div>

                    {# Profil Cirque #}
                    <div class="sm:col-span-2 mt-8 mb-4 border-b border-slate-200 pb-2">
                        <h3 class="text-xl font-bold text-secondary">{{ 'account.profile.circus_profile'|trans }}</h3>
                    </div>

                    {{ _self.form_field(form.practiceStartYear) }}
                    {{ _self.form_field(form.lastPerformance) }}
                    {{ _self.form_field(form.company) }}
                    {{ _self.form_field(form.instagramAccount) }}

                    <div class="sm:col-span-2">
                        <div>
                            {{ form_label(form.specialties, null, {'label_attr': {'class': 'text-sm font-medium uppercase tracking-wider text-state'}}) }}

                            {{ form_widget(form.specialties, {
                                'attr': {
                                    'class': 'tom-select-specialties mt-2 block w-full',
                                    'data-placeholder': 'account.profile.specialties_placeholder'|trans
                                }
                            }) }}

                            <div class="text-sm text-red-500 mt-1">{{ form_errors(form.specialties) }}</div>
                        </div>
                    </div>

                </div>

                <div class="mt-8 flex flex-col-reverse gap-4 border-t border-slate-100 pt-6 sm:flex-row sm:justify-end sm:gap-0 sm:space-x-4">
                    <a href="{{ path('app_user_profile') }}" class="inline-flex items-center justify-center rounded-xl px-6 py-3 text-sm font-semibold text-slate-500 transition hover:bg-slate-100 hover:text-slate-700">
                        {{ 'account.profile.cancel_button'|trans }}
                    </a>
                    <button type="submit" class="inline-flex items-center justify-center rounded-xl bg-secondary px-6 py-3 text-sm font-semibold text-white transition hover:bg-secondary/90 hover:shadow-lg">
                        {{ 'account.profile.save_button'|trans }}
                    </button>
                </div>

                {{ form_end(form) }}
            </section>
        </div>
    </div>
{% endblock %}
