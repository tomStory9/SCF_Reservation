{% extends 'base.html.twig' %}
{% trans_default_domain 'profile' %}

{% block title %}
    {{ 'account.password.edit_title'|trans }} - SCF
{% endblock %}

{% block body %}
    <div class="min-h-screen overflow-x-hidden bg-slate-50 text-slate-900">
        {% include 'user/_partials/_navbar.html.twig' %}

        <div class="mx-auto w-full max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
            <section class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm sm:p-12">

                <div class="mb-14">
                    <p class="text-xs font-bold uppercase tracking-[0.2em] text-state">
                        {{ 'account.profile.section'|trans }}
                    </p>
                    <h2 class="mt-2 text-3xl font-semibold text-secondary">
                        {{ 'account.password.edit_title'|trans }}
                    </h2>
                </div>

                {{ form_start(form, {'attr': {'class': 'space-y-8'}}) }}

                {# Mot de passe actuel #}
                <div>
                    {{ form_label(form.currentPassword, null, {'label_attr': {'class': 'text-sm font-medium uppercase tracking-wider text-state'}}) }}
                    {{ form_widget(form.currentPassword, {'attr': {'class': 'mt-2 block w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-lg font-medium text-secondary transition-colors focus:border-secondary focus:bg-white focus:ring-secondary'}}) }}
                    <div class="text-sm text-red-500 mt-1">{{ form_errors(form.currentPassword) }}</div>
                </div>

                <hr class="border-slate-100 my-8">

                {# Nouveau mot de passe #}
                <div>
                    {{ form_label(form.plainPassword.first, null, {'label_attr': {'class': 'text-sm font-medium uppercase tracking-wider text-state'}}) }}
                    {{ form_widget(form.plainPassword.first, {'attr': {'class': 'mt-2 block w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-lg font-medium text-secondary transition-colors focus:border-secondary focus:bg-white focus:ring-secondary'}}) }}
                    <div class="text-sm text-red-500 mt-1">{{ form_errors(form.plainPassword.first) }}</div>
                </div>

                {# Confirmation #}
                <div class="mt-6">
                    {{ form_label(form.plainPassword.second, null, {'label_attr': {'class': 'text-sm font-medium uppercase tracking-wider text-state'}}) }}
                    {{ form_widget(form.plainPassword.second, {'attr': {'class': 'mt-2 block w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-lg font-medium text-secondary transition-colors focus:border-secondary focus:bg-white focus:ring-secondary'}}) }}
                    <div class="text-sm text-red-500 mt-1">{{ form_errors(form.plainPassword.second) }}</div>
                </div>

                <div class="mt-10 flex flex-col-reverse gap-4 border-t border-slate-100 pt-6 sm:flex-row sm:justify-end sm:gap-0 sm:space-x-4">
                    <a href="{{ path('app_user_profile') }}" class="inline-flex items-center justify-center rounded-xl px-6 py-3 text-sm font-semibold text-slate-500 transition hover:bg-slate-100 hover:text-slate-700">
                        {{ 'account.profile.cancel_button'|trans }}
                    </a>
                    <button type="submit" class="inline-flex items-center justify-center rounded-xl bg-secondary px-6 py-3 text-sm font-semibold text-white transition hover:bg-secondary/90 hover:shadow-lg">
                        {{ 'account.password.save_button'|trans }}
                    </button>
                </div>

                {{ form_end(form) }}
            </section>
        </div>
    </div>
{% endblock %}
