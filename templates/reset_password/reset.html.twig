{% extends 'base.html.twig' %}

{% trans_default_domain 'reset_password' %}

{% block title %}{{ 'reset.title'|trans }}{% endblock %}

{% block body %}
    <div class="flex min-h-screen bg-white">

        <main class="flex w-full items-center justify-center p-4 lg:w-1/2 lg:p-8">

            <div class="w-full max-w-lg">

                <div class="mb-6 flex items-center justify-center gap-4">
                    <img src="{{ asset('build/images/scf.svg') }}" alt="{{ 'app.logo_1'|trans({}, 'messages') }}" class="h-14 w-auto">
                    <img src="{{ asset('build/images/kitokuras.svg') }}" alt="{{ 'app.logo_2'|trans({}, 'messages') }}" class="h-14 w-auto">
                </div>

                <div class="mb-6 text-center">
                    <h1 class="text-3xl font-bold text-primary">
                        {{ 'reset.title'|trans }}
                    </h1>
                    <p class="mt-2 text-secondary">
                        {{ 'reset.subtitle'|trans }}
                    </p>
                </div>

                {{ form_start(resetForm, {'attr': {'class': 'space-y-4'}}) }}

                <div>
                    {{ form_label(resetForm.plainPassword.first, 'reset.new_password'|trans, {'label_attr': {'class': 'mb-2 block text-sm font-medium text-state'}}) }}

                    {{ form_widget(resetForm.plainPassword.first, {'attr': {
                        'class': 'w-full rounded-xl border bg-white px-4 py-3 text-state outline-none transition placeholder:text-state border-state focus:border-primary focus:ring-2 focus:ring-primary',
                        'placeholder': 'reset.password_placeholder'|trans
                    }}) }}

                    <div class="text-sm text-danger mt-1">{{ form_errors(resetForm.plainPassword.first) }}</div>
                </div>

                <div>
                    {{ form_label(resetForm.plainPassword.second, 'reset.confirm_password'|trans, {'label_attr': {'class': 'mb-2 block text-sm font-medium text-state'}}) }}

                    {{ form_widget(resetForm.plainPassword.second, {'attr': {
                        'class': 'w-full rounded-xl border bg-white px-4 py-3 text-state outline-none transition placeholder:text-state border-state focus:border-primary focus:ring-2 focus:ring-primary',
                        'placeholder': 'reset.password_placeholder'|trans
                    }}) }}

                    <div class="text-sm text-danger mt-1">{{ form_errors(resetForm.plainPassword.second) }}</div>
                </div>

                <button type="submit" class="mt-6 w-full rounded-xl bg-secondary py-3 font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-secondary/90 hover:shadow-lg">
                    {{ 'reset.submit'|trans }}
                </button>

                {{ form_end(resetForm) }}

            </div>

        </main>

        <aside class="hidden lg:block lg:w-1/2">
            <img src="{{ asset('build/images/loginBG.png') }}" alt="" class="h-screen w-full object-cover">
        </aside>

    </div>
{% endblock %}
