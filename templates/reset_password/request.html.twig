{% extends 'base.html.twig' %}

{% trans_default_domain 'reset_password' %}

{% block title %}{{ 'request.title'|trans }}{% endblock %}

{% block body %}
    <div class="flex min-h-screen bg-white">

        <main class="flex w-full items-center justify-center p-4 lg:w-1/2 lg:p-8">

            <div class="w-full max-w-lg">

                <div class="mb-6 flex items-center justify-center gap-4">
                    <img src="{{ asset('build/images/scf.svg') }}" alt="{{ 'app.logo_1'|trans({}, 'messages') }}" class="h-14 w-auto">
                    <img src="{{ asset('build/images/kitokuras.svg') }}" alt="{{ 'app.logo_2'|trans({}, 'messages') }}" class="h-14 w-auto">
                </div>

                <div class="mb-6 text-center">
                    <h1 class="text-3xl font-bold text-primary">
                        {{ 'request.title'|trans }}
                    </h1>
                    <p class="mt-2 text-secondary">
                        {{ 'request.subtitle'|trans }}
                    </p>
                </div>

                {# Gestion des erreurs spécifiques au reset #}
                {% for flash_error in app.flashes('reset_password_error') %}
                    <div class="mb-6">
                        <div class="flex items-center gap-4 rounded-2xl border border-danger bg-danger/10 p-4">
                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-danger font-bold text-white">
                                !
                            </div>
                            <p class="text-sm font-medium leading-6 text-danger">
                                {{ flash_error }}
                            </p>
                        </div>
                    </div>
                {% endfor %}

                {{ form_start(requestForm, {'attr': {'class': 'space-y-4'}}) }}

                <div>
                    {{ form_label(requestForm.email, 'request.email'|trans, {'label_attr': {'class': 'mb-2 block text-sm font-medium text-state'}}) }}

                    {{ form_widget(requestForm.email, {'attr': {
                        'class': 'w-full rounded-xl border bg-white px-4 py-3 text-state outline-none transition placeholder:text-state border-state focus:border-primary focus:ring-2 focus:ring-primary',
                        'placeholder': 'request.email_placeholder'|trans,
                        'autocomplete': 'email',
                        'autofocus': true
                    }}) }}

                    <div class="text-sm text-danger mt-1">{{ form_errors(requestForm.email) }}</div>
                </div>

                <button type="submit" class="mt-4 w-full rounded-xl bg-secondary py-3 font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-secondary/90 hover:shadow-lg">
                    {{ 'request.submit'|trans }}
                </button>

                {{ form_end(requestForm) }}

                <div class="mt-8 text-center text-sm text-state">
                    <a href="{{ path('app_login') }}" class="font-semibold text-secondary transition-colors hover:text-primary hover:underline">
                        {{ 'request.back_to_login'|trans }}
                    </a>
                </div>

            </div>

        </main>

        <aside class="hidden lg:block lg:w-1/2">
            <img src="{{ asset('build/images/loginBG.png') }}" alt="" class="h-screen w-full object-cover">
        </aside>

    </div>
{% endblock %}
