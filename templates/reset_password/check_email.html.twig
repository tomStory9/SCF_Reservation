{% extends 'base.html.twig' %}

{% trans_default_domain 'reset_password' %}

{% block title %}{{ 'check_email.title'|trans }}{% endblock %}

{% block body %}
    <div class="flex min-h-screen bg-white">

        <main class="flex w-full items-center justify-center p-4 lg:w-1/2 lg:p-8">

            <div class="w-full max-w-lg text-center">

                <div class="mb-6 flex items-center justify-center gap-4">
                    <img src="{{ asset('build/images/scf.svg') }}" alt="SCF" class="h-14 w-auto">
                    <img src="{{ asset('build/images/kitokuras.svg') }}" alt="Kitokuras" class="h-14 w-auto">
                </div>

                <div class="mb-6">
                    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-primary/10 mb-4">
                        <span class="text-2xl text-primary">✉️</span>
                    </div>
                    <h1 class="text-3xl font-bold text-primary">
                        {{ 'check_email.title'|trans }}
                    </h1>
                    <p class="mt-4 text-secondary leading-relaxed">
                        {{ 'check_email.message'|trans }}
                    </p>
                </div>

                <div class="mb-8 rounded-2xl border border-primary/30 bg-primary/5 p-4">
                    <p class="text-sm font-medium text-secondary">
                        {{ 'check_email.expiration'|trans({'%limit%': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle')}) }}
                    </p>
                </div>

                <p class="text-sm text-state">
                    {{ 'check_email.spam'|trans }}
                    <a href="{{ path('app_forgot_password_request') }}" class="font-semibold text-secondary hover:text-primary hover:underline">
                        {{ 'check_email.try_again'|trans }}
                    </a>
                </p>

            </div>

        </main>

        <aside class="hidden lg:block lg:w-1/2">
            <img src="{{ asset('build/images/loginBG.png') }}" alt="" class="h-screen w-full object-cover">
        </aside>

    </div>
{% endblock %}
